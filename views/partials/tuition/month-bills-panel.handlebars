{{#if activeBills.length}}
<section class="my-3" aria-labelledby="saved-month-bill-heading">
  <h2 id="saved-month-bill-heading" class="h5">本月繳費總覽</h2>
  {{#if monthSummary.issuedCount}}
  <dl class="row mb-2">
    <dt class="col-sm-3">正式帳單應收</dt><dd class="col-sm-9">{{monthSummary.issuedText}}</dd>
    <dt class="col-sm-3">已收</dt><dd class="col-sm-9">{{monthSummary.paidText}}</dd>
    <dt class="col-sm-3">待繳</dt><dd class="col-sm-9"><strong>{{monthSummary.remainingText}}</strong></dd>
    <dt class="col-sm-3">已退</dt><dd class="col-sm-9">{{monthSummary.refundedText}}</dd>
    <dt class="col-sm-3">實收</dt><dd class="col-sm-9">{{monthSummary.netReceivedText}}</dd>
  </dl>
  {{/if}}
  {{#if monthSummary.draftCount}}
  <p class="text-muted">{{monthSummary.draftCount}} 張草稿尚未計入應收。</p>
  {{/if}}
  <div class="table-responsive">
    <table class="table table-sm">
      <thead><tr><th scope="col">帳單</th><th scope="col">狀態</th><th scope="col">金額</th><th scope="col">待繳</th></tr></thead>
      <tbody>
        {{#each activeBills}}
        <tr>
          <th scope="row"><a href="{{detailUrl}}">{{#if isSupplement}}補單{{else}}主帳單{{/if}} {{documentNo}}</a></th>
          <td>{{statusText}}</td><td>{{totalText}}</td><td>{{remainingText}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#if paymentGroupFormUrl}}
  <a class="btn btn-sm btn-outline-primary" href="{{paymentGroupFormUrl}}">登記一筆匯款到多張帳單</a>
  {{/if}}
</section>
{{/if}}

{{#if voidedBills.length}}
<details class="my-3">
  <summary class="font-weight-bold">本月作廢與捨棄紀錄（{{voidedBills.length}}）</summary>
  <ul class="mt-2">
    {{#each voidedBills}}
    <li>
      <a href="{{detailUrl}}">帳單 {{documentNo}}</a>｜{{studentNameSnapshot}}｜{{statusText}}｜原金額 NT$ {{totalAmount}}
    </li>
    {{/each}}
  </ul>
</details>
{{/if}}
