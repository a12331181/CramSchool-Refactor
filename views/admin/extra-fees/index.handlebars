{{#> workspace/page-heading}}
  <a class="ws-btn ws-primary" href="/admin/extrafees/create">{{> workspace/icon name="plus"}}建立新的額外費用</a>
{{/workspace/page-heading}}

<div class="ws-content">
<div class="table-responsive">
<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">編號</th>
      <th scope="col">費用名稱</th>
      <th scope="col">價格</th>
      <th scope="col">操作</th>
    </tr>
  </thead>
  <tbody>
    {{#each extrafees}}
    <tr>
      <th scope="row">{{this.id}}</th>
      <td>{{this.name}}</td>
      <td>{{this.price}}</td>
      <td>
        <a href="/admin/extrafees/{{this.id}}/edit">修改</a>
      </td>
    </tr>
    {{else}}
    <tr><td colspan="4">目前沒有額外費用。</td></tr>
    {{/each}}
  </tbody>
</table>
</div>
</div>
