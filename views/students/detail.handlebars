{{#> workspace/page-heading}}
  <a class="ws-btn" href="/cramschool/timetable?studentId={{student.id}}">{{> workspace/icon name="calendar"}}學生課表</a>
{{/workspace/page-heading}}

<div class="ws-content">
{{> workspace/student-profile}}

<section class="ws-sheet ws-course-section"><h2>目前正在進行的課程</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>課號</th><th>課程名稱</th><th>操作</th></tr></thead>
<tbody>{{#each enrolledCourses}}<tr><td>{{#if courseNo}}{{courseNo}}{{else}}—{{/if}}</td><th scope="row">{{name}}</th><td class="ws-tools"><a href="/cramschool/courses/{{id}}/calendar">課程行事曆</a> <a href="/cramschool/students/{{../student.id}}/courses/{{id}}/attend">出缺席紀錄</a></td></tr>
{{else}}<tr><td colspan="3">尚無進行中的課程。</td></tr>{{/each}}</tbody></table></div></section>
<a href="/cramschool/students{{#if directoryQuery}}?{{directoryQuery}}#student-{{student.id}}{{/if}}">回學生名單</a>
</div>
