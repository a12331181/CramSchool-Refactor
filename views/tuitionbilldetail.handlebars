<h1 class="mt-3">月帳單明細 #{{bill.id}}</h1>
<p>{{bill.studentNameSnapshot}}｜{{bill.billingMonth}}｜{{statusText}}</p>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">項目</th>
      <th scope="col">數量</th>
      <th scope="col">單價</th>
      <th scope="col">金額</th>
      <th scope="col">核對提醒</th>
      {{#if isDraft}}
      <th scope="col">操作</th>
      {{/if}}
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <th scope="row">{{this.descriptionSnapshot}}</th>
      <td>{{this.quantity}}</td>
      <td>NT$ {{this.unitPrice}}</td>
      <td>NT$ {{this.amount}}</td>
      <td>
        {{#if this.reviewCount}}待核對（{{this.reviewCount}} 項）{{else}}—{{/if}}
        {{#if this.reason}}<div>{{this.reason}}</div>{{/if}}
      </td>
      {{#if ../isDraft}}
      <td>
        {{#if this.canRemove}}
        <form method="POST" action="/cramschool/tuition/bills/{{../bill.id}}/items/{{this.id}}/remove">
          <input type="hidden" name="tuitionFormToken" value="{{../issueForm.formToken}}">
          <input type="hidden" name="billVersion" value="{{../bill.version}}">
          <button type="submit" class="btn btn-sm btn-outline-danger"
            aria-label="移除 {{this.descriptionSnapshot}}">移除</button>
        </form>
        {{else}}
        <span class="text-muted">—</span>
        {{/if}}
      </td>
      {{/if}}
    </tr>
    {{else}}
    <tr>
      <td colspan="{{#if isDraft}}6{{else}}5{{/if}}">目前沒有帳單明細。</td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{#with paymentSummary}}
<section class="my-4" aria-labelledby="payment-summary-heading">
  <h2 id="payment-summary-heading" class="h5">收款摘要</h2>
  <p>收款狀態：<strong>{{statusText}}</strong></p>

  {{#if errorMessage}}
  <p class="alert alert-warning" role="alert">{{errorMessage}}</p>
  {{else}}
  <dl class="row mb-0">
    <div class="col-sm-4">
      <dt>應收金額</dt>
      <dd>NT$ {{totalAmount}}</dd>
    </div>
    <div class="col-sm-4">
      <dt>已收金額</dt>
      <dd>NT$ {{paidAmount}}</dd>
    </div>
    <div class="col-sm-4">
      <dt>未收金額</dt>
      <dd>NT$ {{remainingAmount}}</dd>
    </div>
  </dl>
  {{#with paymentForm}}
  <form method="POST" action="{{action}}" class="mt-3" onsubmit="return confirm('確認已收到這筆款項，要登記收款嗎？')">
    <input type="hidden" name="tuitionFormToken" value="{{formToken}}">
    <input type="hidden" name="amount" value="{{amount}}">
    <button type="submit" class="btn btn-primary">登記收款 NT$ {{amount}}</button>
  </form>
  {{/with}}
  {{/if}}
</section>
{{else}}
<p><strong>帳單金額：NT$ {{bill.totalAmount}}</strong></p>
{{/with}}

{{#if isDraft}}
<h2 class="h5">加入額外費用</h2>

{{#with leaveCreditPanel}}
<section class="my-4" aria-labelledby="leave-credit-heading">
  <h2 id="leave-credit-heading" class="h5">
    {{#if reviewMonth}}{{reviewMonth}} {{/if}}請假折抵
  </h2>

  {{#if errorMessage}}
  <p class="alert alert-warning">{{errorMessage}}</p>
  {{else}}
  {{#if options.length}}
  <ul class="list-group mb-3">
    {{#each options}}
    <li class="list-group-item">
      <div><strong>{{courseName}}</strong>｜{{classAtText}}</div>
      <div>可折抵 NT$ {{amount}}（原帳單 #{{sourceBillId}}）</div>
      {{#if leaveReason}}<div class="text-muted">請假原因：{{leaveReason}}</div>{{/if}}

      {{#if ../formToken}}
      <form method="POST" action="{{../action}}" class="mt-2">
        <input type="hidden" name="tuitionFormToken" value="{{../formToken}}">
        <input type="hidden" name="billVersion" value="{{../billVersion}}">
        <input type="hidden" name="attendId" value="{{attendId}}">
        <button type="submit" class="btn btn-sm btn-primary">加入折抵</button>
      </form>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="text-muted">目前沒有可加入的請假折抵。</p>
  {{/if}}

  {{#if blocked.length}}
  <h3 class="h6">其餘已核准請假</h3>
  <ul class="mb-0">
    {{#each blocked}}
    <li>{{courseName}}｜{{classAtText}}：{{statusText}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{/if}}
</section>
{{/with}}

{{#if extraFeeFormToken}}
<form method="POST" action="/cramschool/tuition/bills/{{bill.id}}/extra-fees" class="mb-3">
  <input type="hidden" name="tuitionFormToken" value="{{extraFeeFormToken}}">
  <input type="hidden" name="billVersion" value="{{bill.version}}">

  <label for="bill-extra-fee">費用項目</label>
  <select id="bill-extra-fee" name="extraFeeId" class="form-control mb-2" required>
    <option value="" selected disabled>請選擇</option>
    {{#each extraFees}}
    <option value="{{id}}">{{name}}（NT$ {{price}}）</option>
    {{/each}}
  </select>

  <label for="bill-extra-quantity">數量</label>
  <input id="bill-extra-quantity" name="quantity" type="number" class="form-control mb-2" value="1" min="1" max="999"
    step="1" required>

  <button type="submit" class="btn btn-primary">加入帳單</button>
</form>
{{else}}
<p class="text-muted">目前沒有可加入的費用，或所有項目都已加入。</p>
{{/if}}

<p><a href="/admin/extrafees">管理額外費用目錄</a></p>
{{/if}}

{{#if isDraft}}
<section class="my-4" aria-labelledby="refresh-draft-heading">
  <h2 id="refresh-draft-heading" class="h5">更新草稿</h2>
  <p class="text-muted">
    排課、選課或價格變動時，先回到同月合併預覽核對，再更新課程明細。已加入的額外費用與請假折抵會保留。
  </p>

  <form method="POST" action="/cramschool/tuition/bills/{{bill.id}}/refresh">
    <input type="hidden" name="tuitionFormToken" value="{{issueForm.formToken}}">
    <input type="hidden" name="billVersion" value="{{bill.version}}">
    <button type="submit" class="btn btn-outline-primary">更新草稿</button>
  </form>
</section>
{{/if}}

{{#with issueForm}}
<section class="my-4" aria-labelledby="issue-bill-heading">
  <h2 id="issue-bill-heading" class="h5">正式出帳</h2>
  <p class="text-muted">
    請核對上方的明細與應收金額 NT$ {{../bill.totalAmount}}。
    出帳後，這張帳單的明細與金額會固定。
  </p>

  {{#if unappliedCreditCount}}
  <p class="alert alert-warning">
    有 {{unappliedCreditCount}} 筆已核准的請假可以折抵。請先到<a href="#leave-credit-heading">請假折抵</a>加入，或填寫本張不折抵的原因。
  </p>
  {{/if}}

  <form method="POST" action="{{action}}" onsubmit="return confirm('確認明細與金額，正式出帳？')">
    <input type="hidden" name="tuitionFormToken" value="{{formToken}}">
    <input type="hidden" name="billVersion" value="{{billVersion}}">
    {{#if unappliedCreditCount}}
    <input type="hidden" name="leaveCreditSkipKey" value="{{leaveCreditSkipKey}}">
    <label for="leave-credit-skip-reason">本張不折抵的原因</label>
    <textarea id="leave-credit-skip-reason" name="leaveCreditSkipReason" class="form-control mb-2" rows="2"
      maxlength="255" required></textarea>
    <p class="text-muted">本張未折抵的項目不會自動轉到下一期。</p>
    <button type="submit" class="btn btn-primary">本張不折抵，正式出帳</button>
    {{else}}
    <button type="submit" class="btn btn-primary">正式出帳</button>
    {{/if}}
  </form>
</section>
{{/with}}

{{#if isDraft}}
<section class="my-4 border-top pt-3" aria-labelledby="discard-draft-heading">
  <h2 id="discard-draft-heading" class="h5">捨棄草稿</h2>
  <p class="text-muted">
    捨棄後會保留原帳單和操作紀錄。你可以回到同月合併預覽，重新建立草稿。
  </p>

  <form method="POST" action="/cramschool/tuition/bills/{{bill.id}}/discard" onsubmit="return confirm('確定捨棄這張草稿嗎？')">
    <input type="hidden" name="tuitionFormToken" value="{{issueForm.formToken}}">
    <input type="hidden" name="billVersion" value="{{bill.version}}">

    <label for="discard-draft-reason">捨棄原因</label>
    <textarea id="discard-draft-reason" name="reason" class="form-control mb-2" rows="2" maxlength="255"
      required></textarea>
    <button type="submit" class="btn btn-outline-danger">捨棄草稿</button>
  </form>
</section>
{{/if}}

{{#with voidForm}}
<section class="my-4 border-top pt-3" aria-labelledby="void-issued-bill-heading">
  <h2 id="void-issued-bill-heading" class="h5">作廢帳單</h2>
  <p class="text-muted">作廢會保留原帳單、明細及操作紀錄。你可以回到同月合併預覽重新開單。</p>

  <form method="POST" action="{{action}}" onsubmit="return confirm('確定作廢這張已出帳的帳單嗎？')">
    <input type="hidden" name="tuitionFormToken" value="{{formToken}}">
    <input type="hidden" name="billVersion" value="{{billVersion}}">

    <label for="void-issued-bill-reason">作廢原因</label>
    <textarea id="void-issued-bill-reason" name="reason" class="form-control mb-2" rows="2" maxlength="255"
      required></textarea>
    <button type="submit" class="btn btn-outline-danger">作廢帳單</button>
  </form>
</section>
{{/with}}

<details class="my-4">
  <summary class="font-weight-bold">帳單異動紀錄</summary>
  {{#if billHistory.rows.length}}
  <p class="text-muted mt-2">最多顯示最近 {{billHistory.limit}} 筆操作。</p>
  <div class="table-responsive">
    <table class="table table-sm table-bordered">
      <thead>
        <tr>
          <th scope="col">時間（台北）</th>
          <th scope="col">操作人</th>
          <th scope="col">操作</th>
          <th scope="col">異動內容</th>
          <th scope="col">原因</th>
        </tr>
      </thead>
      <tbody>
        {{#each billHistory.rows}}
        <tr>
          <td>{{occurredAtText}}</td>
          <td>{{actorText}}</td>
          <td>{{actionText}}</td>
          <td>{{detailText}}</td>
          <td>{{reason}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="text-muted mt-2">這張帳單目前沒有操作紀錄。</p>
  {{/if}}
</details>

<a href="{{previewUrl}}">回到同月合併預覽</a>