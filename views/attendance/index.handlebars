<br>

{{> staff-nav activeTab="attendance" showBilling=isAdmin}}

<br>

<h5>
  {{#if isAdmin}}
  全部課堂時段（台北時間）
  {{else}}
  我的課堂時段（台北時間）
  {{/if}}
</h5>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">課程</th>
      <th scope="col">開始時間</th>
      <th scope="col">結束時間</th>
      <th scope="col">狀態</th>
      <th scope="col">課堂內容</th>
      <th scope="col">學生名單</th>
    </tr>
  </thead>
  <tbody>
    {{#each calendars}}
    <tr>
      <td>{{this.courseName}}</td>
      <td>{{this.startAtText}}</td>
      <td>{{this.endAtText}}</td>
      <td>{{this.statusText}}</td>
      <td>{{this.content}}</td>
      <td>
        {{#if this.canViewStudents}}
        <a href="/cramschool/attend/courses/{{this.courseId}}/calendar/{{this.id}}/students"
          class="btn btn-sm btn-outline-primary">查看名單</a>
        {{else}}
        —
        {{/if}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="6" class="text-center text-muted">
        目前沒有安排的課堂。
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
