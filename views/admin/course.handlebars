<br />

<h1>{{course.name}}</h1>
<h4 class="ml-2" style="color: rgb(182, 190, 202)">課程行事曆</h4>

<a href="/admin/courses/{{course.id}}/sessions/create" class="btn btn-primary mb-3">
  新增課堂
</a>

<table class="table table-bordered">
  <thead class="thead-dark">
    <tr>
      <th scope="col">#</th>
      <th scope="col">原紀錄日期</th>
      <th scope="col">開始時間（台北）</th>
      <th scope="col">結束時間（台北）</th>
      <th scope="col">課堂狀態</th>
      <th scope="col">期數</th>
      <th scope="col">課程內容</th>
      <th scope="col">#</th>
    </tr>
  </thead>
  <tbody>
    {{#each calendars}}
    <tr class="{{this.rowClass}}">
      <th scope="row">{{this.id}}</th>
  
      <td>{{#if this.date}}{{this.date}}{{else}}—{{/if}}</td>
      <td>{{this.startAtText}}</td>
      <td>{{this.endAtText}}</td>
      <td>{{this.statusText}}</td>
      <td>{{#if this.period}}第{{this.period}}期{{else}}—{{/if}}</td>
      <td>{{this.content}}</td>
  
      <td>
        {{#if this.isLegacy}}
          {{#if this.isActive}}
          <a class="btn btn-link" href="/admin/courses/{{../course.id}}/calendar/{{this.id}}/edit">
            修改原紀錄
          </a>
        
          <form action="/admin/courses/{{../course.id}}/calendar/{{this.id}}/close?_method=PUT" method="POST"
            style="display: inline;">
            <button type="submit" class="btn btn-sm btn-danger">
              關閉點名
            </button>
          </form>
          {{else}}
          <span class="btn btn-link disabled" aria-disabled="true">
            修改原紀錄
          </span>
        
          <form action="/admin/courses/{{../course.id}}/calendar/{{this.id}}/open?_method=PUT" method="POST"
            style="display: inline;">
            <button type="submit" class="btn btn-sm btn-warning">
              開啟點名
            </button>
          </form>
          {{/if}}
          {{else}}
          {{#if this.canComplete}}
          <form action="/admin/courses/{{../course.id}}/sessions/{{this.id}}/complete?_method=PUT&amp;page={{../page}}"
            method="POST" style="display: inline;" onsubmit="return confirm('確定完成這堂課嗎？完成後，老師將無法再新增或更正點名。')">
            <button type="submit" class="btn btn-sm btn-success">
              完成課堂
            </button>
          </form>
          {{/if}}
        
          {{#if this.canCancel}}
          <form action="/admin/courses/{{../course.id}}/sessions/{{this.id}}/cancel?_method=PUT&amp;page={{../page}}"
            method="POST" style="display: inline;" onsubmit="return confirm('確定取消這堂課嗎？')">
            <button type="submit" class="btn btn-sm btn-outline-danger">
              取消課堂
            </button>
          </form>
          {{else}}
          <span class="text-muted">—</span>
          {{/if}}
        {{/if}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="8" class="text-center text-muted">
        尚未建立課堂
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<nav aria-label="Page navigation example">
  <ul class="pagination justify-content-center">
    <li class="page-item">
      <a class="page-link" href="/admin/courses/{{course.id}}/calendar?page={{prev}}" aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
    {{#each totalPage}}
    {{#ifCond this ../page}}
    <li class="page-item active"><a class="page-link" href="#">{{this}}</a></li>
    {{else}}
    <li class="page-item"><a class="page-link"
      href="/admin/courses/{{../course.id}}/calendar?page={{this}}">{{this}}</a></li>
    {{/ifCond}}
    {{/each}}
    <li class="page-item"><a class="page-link" href="/admin/courses/{{course.id}}/calendar?page={{next}}"
        aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
  </ul>
</nav>

<a href="/admin/courses">回到後台課程頁面</a>
