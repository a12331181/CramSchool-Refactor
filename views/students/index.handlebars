<br>

{{> staff-nav activeTab="students" showBilling=isAdmin}}

<br>

<form action="/cramschool/students">
  <div class="form-group d-flex justify-content-center">
    <label class="mr-2 mt-1" for="courseId"><strong style="color: rgb(83, 6, 6);">依課程篩選: </strong></label>
    <select name="courseId" id="courseId" class="form-control-sm col-8" onchange="this.form.submit()">
      <option value="" {{#ifCond '' courseId}} selected{{/ifCond}}>全部學生</option>
      {{#each courses}}
        <option value="{{this.id}}" {{#ifCond this.id ../courseId}} selected{{/ifCond}}>{{referenceLabel this.courseNo this.name}}</option>
      {{/each}}
    </select>
  </div>
</form>

<table class="table table-bordered">
  <thead>
    <tr class="table-primary">
      <th scope="col">#</th>
      <th scope="col">學生姓名</th>
      <th scope="col">學校</th>
      <th scope="col">年級</th>
      <th scope="col">#</th>
    </tr>
  </thead>
  <tbody>
    {{#each students}}
    <tr class="table-light">
      <th scope="row">{{this.id}}</th>
      <td>{{referenceLabel this.studentNo this.name}}</td>
      <td>{{this.school}}</td>
      <td>{{this.grade}}</td>
      <th scope="col">
        <a href="/cramschool/students/{{this.id}}" class="btn btn-sm btn-dark">基本資料</a>
      </th>
    </tr>
    {{else}}
    <tr>
      <td colspan="5" class="text-center">
        沒有符合條件的學生
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<br />
{{> pagination ariaLabel="學生列表分頁"}}