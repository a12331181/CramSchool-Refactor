<h1 class="mt-3">月帳單明細 #{{bill.id}}</h1>
<p>{{bill.studentNameSnapshot}}｜{{bill.billingMonth}}｜{{statusText}}</p>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">項目</th>
      <th scope="col">數量</th>
      <th scope="col">單價</th>
      <th scope="col">金額</th>
      <th scope="col">核對提醒</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <th scope="row">{{this.descriptionSnapshot}}</th>
      <td>{{this.quantity}}</td>
      <td>NT$ {{this.unitPrice}}</td>
      <td>NT$ {{this.amount}}</td>
      <td>
        {{#if this.reviewCount}}待核對（{{this.reviewCount}} 項）{{else}}—{{/if}}
        {{#if this.reason}}<div>{{this.reason}}</div>{{/if}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="5">目前沒有帳單明細。</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<p><strong>帳單金額：NT$ {{bill.totalAmount}}</strong></p>

{{#if isDraft}}
<h2 class="h5">加入額外費用</h2>

{{#with leaveCreditPanel}}
<section class="my-4" aria-labelledby="leave-credit-heading">
  <h2 id="leave-credit-heading" class="h5">
    {{#if reviewMonth}}{{reviewMonth}} {{/if}}請假折抵
  </h2>

  {{#if errorMessage}}
  <p class="alert alert-warning">{{errorMessage}}</p>
  {{else}}
  {{#if options.length}}
  <ul class="list-group mb-3">
    {{#each options}}
    <li class="list-group-item">
      <div><strong>{{courseName}}</strong>｜{{classAtText}}</div>
      <div>可折抵 NT$ {{amount}}（原帳單 #{{sourceBillId}}）</div>

      {{#if ../formToken}}
      <form method="POST" action="{{../action}}" class="mt-2">
        <input type="hidden" name="tuitionFormToken" value="{{../formToken}}">
        <input type="hidden" name="billVersion" value="{{../billVersion}}">
        <input type="hidden" name="attendId" value="{{attendId}}">
        <button type="submit" class="btn btn-sm btn-primary">加入折抵</button>
      </form>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="text-muted">目前沒有可加入的請假折抵。</p>
  {{/if}}

  {{#if blocked.length}}
  <h3 class="h6">其餘已核准請假</h3>
  <ul class="mb-0">
    {{#each blocked}}
    <li>{{courseName}}｜{{classAtText}}：{{statusText}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{/if}}
</section>
{{/with}}

{{#if extraFeeFormToken}}
<form method="POST" action="/cramschool/tuition/bills/{{bill.id}}/extra-fees" class="mb-3">
  <input type="hidden" name="tuitionFormToken" value="{{extraFeeFormToken}}">
  <input type="hidden" name="billVersion" value="{{bill.version}}">

  <label for="bill-extra-fee">費用項目</label>
  <select id="bill-extra-fee" name="extraFeeId" class="form-control mb-2" required>
    <option value="" selected disabled>請選擇</option>
    {{#each extraFees}}
    <option value="{{id}}">{{name}}（NT$ {{price}}）</option>
    {{/each}}
  </select>

  <label for="bill-extra-quantity">數量</label>
  <input id="bill-extra-quantity" name="quantity" type="number" class="form-control mb-2" value="1" min="1" max="999"
    step="1" required>

  <button type="submit" class="btn btn-primary">加入帳單</button>
</form>
{{else}}
<p class="text-muted">目前沒有可加入的費用，或所有項目都已加入。</p>
{{/if}}

<p><a href="/admin/extrafees">管理額外費用目錄</a></p>
{{/if}}

{{#if isDraft}}
<section class="my-4" aria-labelledby="refresh-draft-heading">
  <h2 id="refresh-draft-heading" class="h5">更新草稿</h2>
  <p class="text-muted">
    排課、選課或價格變動時，先回到同月合併預覽核對，再更新課程明細。已加入的額外費用與請假折抵會保留。
  </p>

  <form method="POST" action="/cramschool/tuition/bills/{{bill.id}}/refresh">
    <input type="hidden" name="tuitionFormToken" value="{{issueForm.formToken}}">
    <input type="hidden" name="billVersion" value="{{bill.version}}">
    <button type="submit" class="btn btn-outline-primary">更新草稿</button>
  </form>
</section>
{{/if}}

{{#with issueForm}}
<section class="my-4" aria-labelledby="issue-bill-heading">
  <h2 id="issue-bill-heading" class="h5">正式出帳</h2>
  <p class="text-muted">
    請核對上方的明細與應收金額 NT$ {{../bill.totalAmount}}。
    出帳後，這張帳單的明細與金額會固定。
  </p>

  <form method="POST" action="{{action}}" onsubmit="return confirm('確認明細與金額，正式出帳？')">
    <input type="hidden" name="tuitionFormToken" value="{{formToken}}">
    <input type="hidden" name="billVersion" value="{{billVersion}}">
    <button type="submit" class="btn btn-primary">正式出帳</button>
  </form>
</section>
{{/with}}

<a href="{{previewUrl}}">回到同月合併預覽</a>