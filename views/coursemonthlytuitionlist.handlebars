<h1 class="mt-3">課程月學費</h1>
{{#if course}}<h2 class="h5">{{course.name}}</h2>{{/if}}

<form method="GET" action="{{listUrl}}" class="mb-3">
  <label for="billing-month">計費月份</label>
  <input id="billing-month" type="month" name="billingMonth" value="{{billingMonth}}" required>
  <button type="submit" class="btn btn-sm btn-primary">查看月學費</button>
</form>

{{#if errorMessage}}
<p class="alert alert-warning">{{errorMessage}}</p>
{{else}}
<p class="text-muted">
  本課費用取自已存帳單的課程明細。收款狀態和未收金額以整張帳單為準，部分收款尚未分配到個別課程。
</p>
<p>共 {{totalCount}} 位學生</p>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
      <tr>
        <th scope="col">學生</th>
        <th scope="col">本課帳單費用</th>
        <th scope="col">帳單／收款狀態</th>
        <th scope="col">整張帳單未收</th>
        <th scope="col">明細</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <th scope="row">{{studentName}}</th>
        <td>{{#if hasCourseAmount}}NT$ {{courseAmount}}{{else}}—{{/if}}</td>
        <td>{{statusText}}</td>
        <td>{{#if hasRemainingAmount}}NT$ {{remainingAmount}}{{else}}—{{/if}}</td>
        <td>
          {{#if billUrl}}<a class="mr-2" href="{{billUrl}}">查看帳單</a>{{/if}}
          {{#if previewUrl}}<a href="{{previewUrl}}">合併預覽</a>{{/if}}
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5">本月沒有選課或有效帳單紀錄。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

<nav class="mb-3" aria-label="課程月學費分頁">
  {{#if prevUrl}}<a href="{{prevUrl}}">上一頁</a>{{/if}}
  <span class="mx-2">第 {{pagination.page}} / {{pagination.totalPages}} 頁</span>
  {{#if nextUrl}}<a href="{{nextUrl}}">下一頁</a>{{/if}}
</nav>
{{/if}}

<a class="mr-2" href="/cramschool/payment">回到課程清單</a>
{{#if studentListUrl}}<a href="{{studentListUrl}}">改按學生查看</a>{{/if}}
