{{> workspace/page-heading}}

<div class="ws-content">
<p class="ws-context">{{referenceLabel student.studentNo student.name}}</p>
<h2>現有課程列表</h2>
<div class="table-responsive">
<table class="ws-mobile-cards table table-bordered">
      <thead>
        <tr>
          <th scope="col">編號</th>
          <th scope="col">課程名稱</th>
          <th scope="col">選課操作</th>
        </tr>
      </thead>
      <tbody>
        {{#each courses}}
        <tr>
          <th scope="row" data-label="編號">{{this.id}}</th>
          <td class="ws-cell-title" data-label="課程名稱">
            {{referenceLabel this.courseNo this.name}}
            {{#unless this.isActive}}（已關閉）{{/unless}}
          </td>
          <td class="ws-cell-actions" data-label="選課操作">
            {{#if this.isEnrolled }}
              <form action="/admin/students/{{../student.id}}/courses/{{this.id}}/enrolls?_method=DELETE" method="POST" class="ws-inline">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <input type="hidden" name="enrollmentId" value="{{this.enrollmentId}}">
                <button type="submit" class="btn btn-danger btn-sm">取消課程</button>
              </form>
            {{else}}
              <form action="/admin/students/{{../student.id}}/courses/{{this.id}}/enrolls" method="POST" class="ws-inline">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <button type="submit" class="btn btn-primary btn-sm">加入課程</button>
              </form>
            {{/if}}
          </td>
        </tr>
        {{else}}<tr><td colspan="3">尚無可顯示的課程。</td></tr>
        {{/each}}
      </tbody>
    </table>
</div>
<a href="/admin/students">回到後台學生列表</a>
</div>
