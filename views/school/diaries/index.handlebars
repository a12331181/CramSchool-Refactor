{{> workspace/page-heading}}

<div class="ws-content">
<div class="table-responsive">
<table class="ws-mobile-cards table table-bordered">
  <thead>
    <tr>
      <th scope="col">編號</th>
      <th scope="col">日期</th>
      <th scope="col">主題</th>
      <th scope="col">課程</th>
      <th scope="col">教師</th>
      {{#if showDeleteColumn}}
      <th scope="col">操作</th>
      {{/if}}
    </tr>
  </thead>
  <tbody>
    {{#each diaries}}
    <tr>
      <th scope="row" data-label="編號">{{this.id}}</th>
      <td data-label="日期">{{this.date}}</td>
      <td class="ws-cell-title" data-label="主題"><a href="/cramschool/courses/{{this.Course.id}}/diaries/{{this.id}}">{{this.subject}}</a></td>
      <td data-label="課程">{{referenceLabel this.Course.courseNo this.Course.name}}</td>
      <td data-label="教師">{{referenceLabel this.Teacher.User.userNo this.Teacher.name}}</td>
      {{#if ../showDeleteColumn}}
      <td class="ws-cell-actions" data-label="操作">
        {{#if canDelete}}
        <form action="/cramschool/diaries/{{this.id}}?_method=DELETE" method="POST" class="ws-inline">
          <button type="submit" class="btn btn-sm btn-danger">刪除</button>
        </form>
        {{/if}}
      </td>
      {{/if}}
    </tr>
    {{else}}
    <tr><td colspan="{{#if showDeleteColumn}}6{{else}}5{{/if}}">目前沒有教師日誌。</td></tr>
    {{/each}}
  </tbody>
</table>
</div>
{{> pagination ariaLabel="全校教師日誌分頁"}}
<a href="/cramschool">回到主頁面</a>
</div>
