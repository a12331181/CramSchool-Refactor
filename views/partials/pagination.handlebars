<nav aria-label="{{ariaLabel}}">
  <ul class="pagination justify-content-center">
    <li class="page-item{{#unless prevUrl}} disabled{{/unless}}">
      {{#if prevUrl}}
      <a class="page-link" href="{{prevUrl}}" aria-label="上一頁">
        <span aria-hidden="true">&laquo;</span>
      </a>
      {{else}}
      <span class="page-link" aria-hidden="true">&laquo;</span>
      {{/if}}
    </li>
    {{#each pageLinks}}
      {{#if isGap}}
      <li class="page-item disabled" aria-hidden="true"><span class="page-link">…</span></li>
      {{else if isCurrent}}
      <li class="page-item active">
        <span class="page-link" aria-current="page">{{number}}</span>
      </li>
      {{else}}
      <li class="page-item">
        <a class="page-link" href="{{url}}">{{number}}</a>
      </li>
      {{/if}}
    {{/each}}
    <li class="page-item{{#unless nextUrl}} disabled{{/unless}}">
      {{#if nextUrl}}
      <a class="page-link" href="{{nextUrl}}" aria-label="下一頁">
        <span aria-hidden="true">&raquo;</span>
      </a>
      {{else}}
      <span class="page-link" aria-hidden="true">&raquo;</span>
      {{/if}}
    </li>
  </ul>
</nav>
