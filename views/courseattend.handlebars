<br>

<h5>
  {{#if isAdmin}}
  全部課堂時段（台北時間）
  {{else}}
  我的課堂時段（台北時間）
  {{/if}}
</h5>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">課程</th>
      <th scope="col">開始時間</th>
      <th scope="col">結束時間</th>
      <th scope="col">狀態</th>
      <th scope="col">課堂內容</th>
      <th scope="col">學生名單</th>
    </tr>
  </thead>
  <tbody>
    {{#each calendars}}
    <tr>
      <td>{{this.courseName}}</td>
      <td>{{this.startAtText}}</td>
      <td>{{this.endAtText}}</td>
      <td>{{this.statusText}}</td>
      <td>{{this.content}}</td>
      <td>
        {{#if this.canViewStudents}}
        <a href="/cramschool/attend/courses/{{this.courseId}}/calendar/{{this.id}}/students"
          class="btn btn-sm btn-outline-primary">查看名單</a>
        {{else}}
        —
        {{/if}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="6" class="text-center text-muted">
        目前沒有安排的課堂。
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{#if courses.length}}
<h5>原有課程點名</h5>
<table class="table table-bordered">
  <thead>
    <tr class="table-primary">
      <th scope="col">#</th>
      <th scope="col">課程名稱</th>
      <th scope="col">授課老師</th>
      <th scope="col">#</th>
    </tr>
  </thead>
  <tbody>
    {{#each courses}}
    <tr class="table-light">
      <th scope="row">{{this.dataValues.id}}</th>
      <td>{{this.dataValues.name}}</td>
      <td>{{this.dataValues.Teacher.dataValues.name}}</td>
      <th scope="col">
        <a href="/cramschool/attend/courses/{{this.dataValues.id}}" class="btn btn-sm btn-dark">課程行事曆列表</a>
      </th>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}