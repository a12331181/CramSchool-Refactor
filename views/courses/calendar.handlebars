<br>

<h1>{{referenceLabel course.courseNo course.name}}</h1>
<h2 class="h4">課堂時段（台北時間）</h2>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead class="table-secondary">
      <tr>
        <th scope="col">開始時間</th>
        <th scope="col">結束時間</th>
        <th scope="col">狀態</th>
        <th scope="col">課堂內容</th>
      </tr>
    </thead>
    <tbody>
      {{#each sessions}}
      <tr>
        <td>{{this.startAtText}}</td>
        <td>{{this.endAtText}}</td>
        <td>{{this.statusText}}</td>
        <td>{{this.content}}</td>
      </tr>
      {{else}}
      <tr><td colspan="4" class="text-center text-muted">目前沒有可顯示的課堂。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

<a href="/cramschool/courses">回課程列表</a>
