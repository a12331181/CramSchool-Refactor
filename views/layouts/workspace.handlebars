<!doctype html>
{{#with (workspacePage @exphbs.view this) as |page|}}
<html lang="zh-Hant">
<head>
  {{> workspace/head title=page.title}}
</head>
<body class="ws">
  <a class="ws-skip" href="#workspace-main">跳到主要內容</a>
  <div class="ws-frame">
    <aside class="ws-sidebar">
      <a class="ws-brand" href="/cramschool"><span class="ws-mark">{{> workspace/icon name="abacus"}}</span>補習班管理系統</a>
      {{> workspace/navigation @root activeNav=page.tab}}
    </aside>
    <div class="ws-canvas">
      <header class="ws-top">
        <details class="ws-mobile">
          <summary aria-label="校務選單">{{> workspace/icon name="menu"}}<span>選單</span></summary>
          <div class="ws-mobile-panel">{{> workspace/navigation @root activeNav=page.tab}}</div>
        </details>
        <div class="ws-crumb">{{> workspace/icon name="grid"}}<a href="/cramschool">校務工作台</a><span aria-hidden="true">/</span><strong>{{page.title}}</strong></div>
        <a class="ws-user" href="/users/{{@root.user.id}}" aria-label="{{@root.user.name}}的個人資料"><span class="ws-user-dot">{{initial @root.user.name}}</span><span>{{@root.user.name}}</span></a>
      </header>
      <main id="workspace-main" class="ws-main" tabindex="-1">
        {{> workspace/messages @root}}
        {{{@root.body}}}
      </main>
    </div>
  </div>
</body>
</html>
{{/with}}
