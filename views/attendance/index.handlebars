<br>
{{> staff-nav activeTab="attendance" showBilling=isAdmin}}
<br>

<h1 class="h4">{{#if isAdmin}}課程點名{{else}}我的授課課程{{/if}}</h1>
<p class="text-muted">先選課程，再查看課堂和點名名單。</p>

<table class="table table-bordered">
  <thead class="table-secondary">
    <tr><th scope="col">課程名稱</th><th scope="col">操作</th></tr>
  </thead>
  <tbody>
    {{#each courses}}
    <tr>
      <th scope="row">{{this.name}}</th>
      <td><a href="/cramschool/attend/courses/{{this.id}}/sessions" class="btn btn-sm btn-outline-primary">查看課堂</a></td>
    </tr>
    {{else}}
    <tr><td colspan="2" class="text-center text-muted">目前沒有可查看的課程。</td></tr>
    {{/each}}
  </tbody>
</table>
