{{> workspace/page-heading}}

<div class="ws-content">
{{#if course}}<p class="ws-context">{{referenceLabel course.courseNo course.name}}</p>{{/if}}

{{> tuition/billing-month-filter formAction=listUrl monthLabel="計費月份:" submitText="查看該月學費"}}

{{#if errorMessage}}
<p class="alert alert-warning">{{errorMessage}}</p>
{{else}}
<p class="text-muted">
  正式帳單顯示分攤折扣與折抵後的本課金額。草稿顯示本課原價，尚未形成應收。實收是本課已收扣除已退費；退費不列為欠款。
</p>
<p>共 {{totalCount}} 位學生</p>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
      <tr>
        <th scope="col">學生姓名</th>
        <th scope="col">本課金額</th>
        <th scope="col">本課已收</th>
        <th scope="col">本課已退</th>
        <th scope="col">本課實收</th>
        <th scope="col">本課未收</th>
        <th scope="col">帳單／收款狀態</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <th scope="row">{{studentName}}</th>
        <td>{{amountText}}</td>
        <td>{{receivedText}}</td>
        <td>{{refundedText}}</td>
        <td>{{netReceivedText}}</td>
        <td>{{remainingText}}</td>
        <td>{{statusText}}{{#if pendingDraftCount}}<small class="d-block text-muted">另有 {{pendingDraftCount}} 張草稿</small>{{/if}}</td>
      </tr>
      {{else}}
      <tr><td colspan="7">本月沒有選課或有效帳單紀錄。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{> pagination ariaLabel="課程月學費分頁"}}

{{/if}}

<a class="me-2" href="{{backUrl}}">回到課程收費列表</a>
</div>
