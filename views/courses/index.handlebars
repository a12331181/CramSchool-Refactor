<br>
{{> staff-nav activeTab="courses" showBilling=isAdmin}}

<h1 class="h4 mt-3">課程列表</h1>
{{#if totalCount}}<p class="text-muted">共 {{totalCount}} 門課程</p>{{/if}}
<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead class="table-secondary">
      <tr>
        <th scope="col">課程編號</th>
        <th scope="col">課程名稱</th>
        <th scope="col">授課老師</th>
        <th scope="col">上課時長</th>
        <th scope="col">操作</th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
      <tr>
        <td>{{#if courseNo}}{{courseNo}}{{else}}—{{/if}}</td>
        <th scope="row">{{name}}</th>
        <td>{{referenceLabel Teacher.User.userNo Teacher.name}}</td>
        <td>{{time}} 分鐘</td>
        <td>
          <a href="/cramschool/courses/{{id}}/calendar" class="btn btn-sm btn-outline-dark">課程行事曆</a>
          <a href="/cramschool/courses/{{id}}/enrolledstudents" class="btn btn-sm btn-outline-secondary">學生名單</a>
          {{#if canViewDiaries}}<a href="/cramschool/courses/{{id}}/diaries" class="btn btn-sm btn-outline-warning">教師日誌</a>{{/if}}
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="text-center text-muted">目前沒有可顯示的課程。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{#if totalCount}}{{> pagination ariaLabel="課程列表分頁"}}{{/if}}
