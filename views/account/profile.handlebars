{{#> workspace/page-heading}}
  {{#if userIsMatch}}<a class="ws-btn ws-primary" href="/users/{{teacher.User.id}}/edit">{{> workspace/icon name="edit"}}編輯個人資料</a>{{/if}}
{{/workspace/page-heading}}

<div class="ws-content">
{{> workspace/teacher-profile}}

<section class="ws-sheet ws-course-section"><h2>目前正在教授的課程</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>課號</th><th>課程名稱</th><th>操作</th></tr></thead>
<tbody>{{#each courses}}<tr><td>{{#if courseNo}}{{courseNo}}{{else}}—{{/if}}</td><th scope="row">{{name}}</th><td class="ws-tools"><a href="/cramschool/courses/{{id}}/calendar">課程行事曆</a> <a href="/cramschool/courses/{{id}}/enrolledstudents">學生名單</a></td></tr>
{{else}}<tr><td colspan="3">尚無進行中的課程。</td></tr>{{/each}}</tbody></table></div></section>
<a href="/cramschool/teachers">回教師名單</a>
</div>
