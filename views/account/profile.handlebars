{{#> workspace/page-heading}}
  {{#if userIsMatch}}<a class="ws-btn ws-primary" href="/users/{{teacher.User.id}}/edit">{{> workspace/icon name="edit"}}編輯個人資料</a>{{/if}}
{{/workspace/page-heading}}

<div class="ws-content">
{{> workspace/teacher-profile}}

{{#if courses}}
<h2>目前正在教授的課程</h2>
<div class="ws-cards">
  {{#each courses}}
  <article class="ws-sheet"><h3>{{referenceLabel courseNo name}}</h3>
    <div class="ws-tools"><a href="/cramschool/courses/{{id}}/calendar">課程行事曆</a><a href="/cramschool/courses/{{id}}/enrolledstudents">學生名單</a></div>
  </article>
  {{/each}}
</div>
{{else}}
<p class="ws-sheet text-muted">目前無正在教授的課程</p>
{{/if}}
<a href="/cramschool/teachers">回教師名單</a>
</div>
