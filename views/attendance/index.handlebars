{{> workspace/page-heading}}

<div class="ws-content">
<p class="text-muted">先選課程，再查看課堂和點名名單。</p>
{{#if totalCount}}<p class="text-muted">共 {{totalCount}} 門可查看的課程</p>{{/if}}

<div class="table-responsive">
<table class="ws-mobile-cards table table-bordered">
  <thead>
    <tr><th scope="col">課程名稱</th><th scope="col">操作</th></tr>
  </thead>
  <tbody>
    {{#each courses}}
    <tr>
      <th scope="row" class="ws-cell-title" data-label="課程名稱">{{referenceLabel this.courseNo this.name}}</th>
      <td class="ws-cell-actions" data-label="操作"><a href="/cramschool/attend/courses/{{this.id}}/sessions" class="btn btn-sm btn-outline-primary">查看課堂</a></td>
    </tr>
    {{else}}
    <tr><td colspan="2" class="text-center text-muted">目前沒有可查看的課程。</td></tr>
    {{/each}}
  </tbody>
</table>
</div>

{{#if totalCount}}{{> pagination ariaLabel="點名課程分頁"}}{{/if}}
</div>
