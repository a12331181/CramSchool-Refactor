{{> workspace/page-heading}}

<div class="ws-content">
<form method="POST" action="/admin/users/invitations" class="ws-filter">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
  <input type="hidden" name="inviteFormToken" value="{{inviteFormToken}}">
  <label for="teacher-invite-email">新老師的登入信箱</label>
  <input id="teacher-invite-email" type="email" name="email" maxlength="254" required>
  <button type="submit" class="btn btn-primary">產生註冊連結</button>
</form>

<div class="table-responsive">
<table class="ws-mobile-cards table table-bordered">
  <thead>
    <tr>
      <th scope="col">編號</th>
      <th scope="col">名稱</th>
      <th scope="col">信箱</th>
      <th scope="col">使用者身分</th>
      <th scope="col">權限操作</th>
    </tr>
  </thead>
  <tbody>
    {{#each users}}
    <tr>
      <th scope="row" data-label="編號">{{this.id}}</th>
      <td class="ws-cell-title" data-label="名稱">{{this.name}}</td>
      <td data-label="信箱">{{this.email}}</td>
      {{#if isAdmin}}
      <td data-label="使用者身分">管理員</td>
      <td class="ws-cell-actions" data-label="權限操作">
        {{#ifCond this.id ../lastAdminId}}
        最後一位管理員
        {{else}}
        <form action="/admin/users/{{this.id}}/toggleAdmin?_method=PUT" method="POST" class="ws-inline">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
          <input type="hidden" name="isAdmin" value="false">
          <button type="submit" class="btn btn-link">
            切換為使用者
          </button>
        </form>
        {{/ifCond}}
      </td>
      {{else}}
      <td data-label="使用者身分">一般使用者</td>
      <td class="ws-cell-actions" data-label="權限操作">
        <form action="/admin/users/{{this.id}}/toggleAdmin?_method=PUT" method="POST" class="ws-inline">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
          <input type="hidden" name="isAdmin" value="true">
          <button type="submit" class="btn btn-link">
            切換為管理員
          </button>
        </form>
      </td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
</div>
