<section class="ws-sheet ws-profile" aria-labelledby="profile-name">
  {{#if teacher.image}}
  <img src="{{teacher.image}}" alt="{{teacher.name}}的照片">
  {{else}}
  <span class="ws-monogram" aria-hidden="true">{{initial teacher.name}}</span>
  {{/if}}
  <div><h2 id="profile-name">{{referenceLabel teacher.User.userNo teacher.name}}</h2>
    <table class="table ws-facts-table" aria-label="基本資料"><tbody>
      <tr><th scope="row">性別</th><td>{{#if teacher.sex}}{{teacher.sex}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">生日</th><td>{{#if teacher.birth}}{{teacher.birth}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">聯絡電話</th><td>{{#if teacher.phone}}{{teacher.phone}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">信箱</th><td>{{#if teacher.User.email}}{{teacher.User.email}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">地址</th><td>{{#if teacher.address}}{{teacher.address}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">最高學歷</th><td>{{#if teacher.education}}{{teacher.education}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">學校</th><td>{{#if teacher.school}}{{teacher.school}}{{else}}—{{/if}}</td></tr>
    </tbody></table>
  </div>
</section>
