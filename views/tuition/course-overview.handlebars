{{> workspace/page-heading}}

<div class="ws-content">
<form method="get" action="{{listUrl}}" class="ws-filter">
  <label for="billing-month">計費月份</label><input id="billing-month" type="month" name="billingMonth" value="{{billingMonth}}" required>
  <label for="collection-filter">收費狀態</label><select id="collection-filter" name="filter">
    <option value="all">全部課程</option><option value="unpaid" {{#ifCond filter "unpaid"}}selected{{/ifCond}}>只看有未收</option>
    <option value="review" {{#ifCond filter "review"}}selected{{/ifCond}}>只看待核對</option>
  </select>
  <label><input type="checkbox" name="totals" value="1" {{#if includeTotals}}checked{{/if}}> 顯示整月合計</label>
  <button class="btn btn-primary">查看</button>
</form>
{{#if totals}}<dl class="ws-stats" aria-label="全部課程整月合計">
<div><dt>整月應收</dt><dd>{{totals.receivableAmount}}</dd></div><div><dt>整月實收</dt><dd>{{totals.netReceivedAmount}}</dd></div>
<div><dt>整月已退</dt><dd>{{totals.refundedAmount}}</dd></div><div><dt>整月未收</dt><dd>{{totals.remainingAmount}}</dd></div></dl>{{/if}}

{{#if errorMessage}}
<p class="alert alert-warning" role="alert">{{errorMessage}}</p>
{{else}}
<p class="text-muted">
  金額以所選計費月份的正式帳單為準。應收是分攤折扣與折抵後的本課金額，不含其他課程或額外費用。
  已收記錄原付款，實收扣除本課已退費；退費不列為欠款。無法分配的舊收款或整單退費會標示待核對。
</p>

<div class="table-responsive">
  <table class="table table-bordered ws-money-table">
    <thead>
      <tr>
        <th scope="col">編號</th>
        <th scope="col">課程名稱</th>
        <th scope="col">本月應收學費總額</th>
        <th scope="col">本課已收</th>
        <th scope="col">本課已退</th>
        <th scope="col">本課實收</th>
        <th scope="col">本課未收</th>
        <th scope="col">收費狀況</th>
        <th scope="col">明細</th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
      <tr>
        <th scope="row">{{this.rowNumber}}</th>
        <td>{{this.courseLabel}}{{#if this.isClosed}} <small class="text-muted">（已關閉）</small>{{/if}}</td>
        <td>{{this.receivableText}}</td>
        <td>{{this.receivedText}}</td>
        <td>{{this.refundedText}}</td>
        <td>{{this.netReceivedText}}</td>
        <td>{{this.remainingText}}</td>
        <td><span class="fw-bold {{this.collectionClass}}">{{this.collectionText}}</span><details class="ws-money-breakdown"><summary>金額明細</summary><p>應收 {{receivableText}}<br>已收 {{receivedText}}<br>已退 {{refundedText}}<br>實收 {{netReceivedText}}</p></details></td>
        <td>
          <a href="{{this.detailUrl}}" class="btn btn-sm btn-primary">
            查看明細
          </a>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="9" class="text-center text-muted">本月沒有課程收費資料。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{> pagination ariaLabel="課程收費分頁"}}
{{/if}}
</div>
