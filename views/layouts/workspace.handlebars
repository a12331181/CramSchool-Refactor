<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{workspaceTitle}} · 補習班管理系統</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css"
    integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
  <link rel="stylesheet" href="/assets/workspace/workspace.css">
</head>
<body class="ws">
  <a class="ws-skip" href="#workspace-main">跳到主要內容</a>
  <div class="ws-frame">
    <aside class="ws-sidebar">
      <a class="ws-brand" href="/cramschool"><span class="ws-mark">{{> workspace/icon name="abacus"}}</span>補習班管理系統</a>
      {{> workspace/navigation}}
    </aside>
    <div class="ws-canvas">
      <header class="ws-top">
        <details class="ws-mobile">
          <summary aria-label="校務選單">{{> workspace/icon name="menu"}}<span>選單</span></summary>
          <div class="ws-mobile-panel">{{> workspace/navigation}}</div>
        </details>
        <div class="ws-crumb">{{> workspace/icon name="grid"}}<a href="/cramschool">校務工作台</a><span aria-hidden="true">/</span><strong>{{workspaceTitle}}</strong></div>
        <a class="ws-user" href="/users/{{user.id}}" aria-label="{{user.name}}的個人資料"><span class="ws-user-dot">{{initial user.name}}</span><span>{{user.name}}</span></a>
      </header>
      <main id="workspace-main" class="ws-main" tabindex="-1">
        {{#if success_messages}}<div class="alert alert-success" role="status">{{success_messages}}</div>{{/if}}
        {{#if error_messages}}<div class="alert alert-danger" role="alert">{{error_messages}}</div>{{/if}}
        {{{body}}}
      </main>
    </div>
  </div>
</body>
</html>
