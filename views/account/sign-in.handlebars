<form class="ws-access-form" action="/signin" method="POST">
  <h1>登入</h1>

  <div class="form-group">
    <label for="inputEmail">信箱</label>
    <input id="inputEmail" type="text" inputmode="email" autocomplete="username" name="email" class="form-control" placeholder="輸入信箱..." required autofocus>
  </div>

  <div class="form-group">
    <label for="inputPassword">密碼</label>
    <input id="inputPassword" type="password" name="password" autocomplete="current-password" class="form-control" placeholder="輸入密碼..." required>
  </div>

  <button class="btn btn-lg btn-primary btn-block my-1" type="submit">登入</button>

</form>
