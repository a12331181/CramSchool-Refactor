{{> workspace/page-heading}}

<div class="ws-content">
<p class="text-muted">在學學生的本月帳單與收款狀況。尚未開單時顯示基本學費試算。實收已扣除退費；已結清仍可有退費紀錄。</p>

{{#> tuition/billing-month-filter formAction=listUrl monthLabel="計費月份:" submitText="查看月學費" submitClass="mb-1"}}
  <span class="d-inline-block ml-sm-2 col-md-6">
    <label for="tuition-status">帳單狀態:</label>
    <select id="tuition-status" name="status" class="form-control-sm"
      onchange="this.form.requestSubmit()">
      {{#each statusOptions}}
      <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </span>
{{/tuition/billing-month-filter}}

{{#if errorMessage}}
  <p class="alert alert-warning">{{errorMessage}}</p>
{{else}}
  <p>共 {{totalCount}} 位符合條件的在學學生</p>

  <div class="table-responsive">
    <table class="table table-bordered ">
      <thead>
        <tr>
          <th scope="col">學生姓名</th>
          <th scope="col">本月金額</th>
          <th scope="col">帳單／收款狀態</th>
          <th scope="col">未收金額</th>
          <th scope="col">已退費</th>
          <th scope="col">實收</th>
          <th scope="col">明細</th>
          <th scope="col">紀錄</th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr>
            <th scope="row">{{this.studentLabel}}</th>
            <td>
              {{#if this.hasAmount}}
              NT$ {{this.amount}}
              <small class="d-block text-muted">{{this.amountSourceText}}</small>
              {{else}}—{{/if}}
            </td>
            <td>
              {{this.statusText}}
              {{#if this.pendingDraftCount}}<small class="d-block text-muted">另有 {{this.pendingDraftCount}} 張草稿</small>{{/if}}
              {{#if this.refundStatusText}}<small class="d-block text-muted">{{this.refundStatusText}}</small>{{/if}}
            </td>
            <td>{{#if this.hasRemainingAmount}}NT$ {{this.remainingAmount}}{{else}}—{{/if}}</td>
            <td>{{this.refundedText}}</td>
            <td>{{this.netReceivedText}}</td>
            <td>

              {{#if this.hasMonthSummary}}
              <a href="{{this.previewUrl}}#saved-month-bill-heading">本月繳費總覽</a>
              {{else}}
              <a href="{{this.previewUrl}}">試算與開單</a>
              {{/if}}
              {{#if this.billUrl}}<span>/</span> <a href="{{this.billUrl}}">查看帳單 {{this.documentNo}}</a>{{/if}}
            </td>

            <td><a href="{{this.historyUrl}}">歷期學費列表</a></td>
          </tr>
        {{else}}
          <tr><td colspan="8">目前沒有符合條件的學生。</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{> pagination ariaLabel="學生學費列表分頁"}}
{{/if}}
</div>
