<br>

{{> staff-nav activeTab="course-payments" showBilling=user.isAdmin}}

<br>

<h1 class="h4">課程收費列表</h1>
{{> tuition/billing-month-filter formAction=listUrl monthLabel="計費月份：" submitText="查看月份"}}

{{#if errorMessage}}
<p class="alert alert-warning" role="alert">{{errorMessage}}</p>
{{else}}
<p class="text-muted">
  金額以所選計費月份的正式帳單為準。應收是分攤折扣與折抵後的本課金額，不含其他課程或額外費用。
  無法分配到本課的舊收款或整單退費會標示待核對。
</p>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
      <tr class="table-primary">
        <th scope="col">#</th>
        <th scope="col">課程名稱</th>
        <th scope="col">本月應收學費總額</th>
        <th scope="col">本課已收</th>
        <th scope="col">本課未收</th>
        <th scope="col">收費狀況</th>
        <th scope="col">明細</th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
      <tr class="table-light">
        <th scope="row">{{this.id}}</th>
        <td>{{this.name}}</td>
        <td>{{this.receivableText}}</td>
        <td>{{this.receivedText}}</td>
        <td>{{this.remainingText}}</td>
        <td><span class="font-weight-bold {{this.collectionClass}}">{{this.collectionText}}</span></td>
        <td>
          <a href="{{this.detailUrl}}" class="btn btn-sm btn-primary">
            每月學費明細
          </a>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="7" class="text-center text-muted">目前沒有開放的課程。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{/if}}
