<ul class="nav nav-tabs">
  <li class="nav-item">
    <a class="nav-link" href="/cramschool">首頁</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" href="/cramschool/courses">課程列表</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" href="/cramschool/teachers">教師列表</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" href="/cramschool/students">學生列表</a>
  </li>
  <li class="nav-item">
    <a class="nav-link active" aria-current="page" href="/cramschool/attend">課程點名</a>
  </li>
