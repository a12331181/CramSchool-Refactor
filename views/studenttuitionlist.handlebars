<br>

{{> staff-nav activeTab="student-payments" showBilling=user.isAdmin}}

<br>

<h1 class="h4">學生學費列表</h1>
<p class="text-muted">在學學生的本月帳單與收款狀況。尚未開單時顯示基本學費試算。</p>

<form action="{{listUrl}}" method="GET" class="mb-3">
  <label for="billing-month">計費月份:</label>
  <input id="billing-month" type="month" name="billingMonth"
    value="{{billingMonth}}" required>
  <button type="submit" class="btn btn-sm btn-primary mb-1">查看月學費</button>
  <span class="d-inline-block ml-sm-2 col-md-6">
    <label for="tuition-status">帳單狀態:</label>
    <select id="tuition-status" name="status" class="form-control-sm"
      onchange="this.form.requestSubmit()">
      {{#each statusOptions}}
      <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
      {{/each}}
    </select>
  </span>
</form>

{{#if errorMessage}}
  <p class="alert alert-warning">{{errorMessage}}</p>
{{else}}
  <p>共 {{totalCount}} 位符合條件的在學學生</p>

  <table class="table table-bordered ">
    <thead>
      <tr class="table-primary">
        <th scope="col">學生姓名</th>
        <th scope="col">本月金額</th>
        <th scope="col">帳單／收款狀態</th>
        <th scope="col">未收金額</th>
        <th scope="col">明細</th>
        <th scope="col">紀錄</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
        <tr>
          <th scope="row">{{this.student.name}}</th>
          <td>
            {{#if this.hasAmount}}
            NT$ {{this.amount}}
            <small class="d-block text-muted">{{this.amountSourceText}}</small>
            {{else}}—{{/if}}
          </td>
          <td>{{this.statusText}}</td>
          <td>{{#if this.hasRemainingAmount}}NT$ {{this.remainingAmount}}{{else}}—{{/if}}</td>
          <td>
            
            <a href="{{this.previewUrl}}">帳單草稿</a>
            <span>/</span>
            {{#if this.billUrl}}<a href="{{this.billUrl}}">本月帳單</a>{{/if}}
          </td>
          
          <td><a href="{{this.historyUrl}}">歷期學費列表</a></td>
        </tr>
      {{else}}
        <tr><td colspan="6">目前沒有符合條件的學生。</td></tr>
      {{/each}}
    </tbody>
  </table>

  {{> pagination ariaLabel="學生學費列表分頁"}}
{{/if}}