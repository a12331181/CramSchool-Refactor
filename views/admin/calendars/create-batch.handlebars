{{> workspace/page-heading}}

<div class="ws-content">
<p class="ws-context">{{referenceLabel course.courseNo course.name}}</p>
<p class="text-muted">多選日期，每個日期各建立一堂課；這批共用同一位老師與起訖時間，時間以台北為準。</p>

{{#if error}}
<div class="alert alert-danger" role="alert">
  <p class="mb-0">{{error}}</p>
  {{#if conflictDates.length}}
  <ul id="batch-conflict-dates" class="mb-0 mt-2">
    {{#each conflictDates}}<li data-date="{{this}}">{{this}}</li>{{/each}}
  </ul>
  {{/if}}
</div>
{{/if}}
{{#unless canSubmit}}
<p class="alert alert-warning">目前沒有可安排的授課老師，請先確認教師資料。</p>
{{/unless}}

<form class="ws-form" action="/admin/courses/{{course.id}}/sessions/batch" method="POST">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
  <input type="hidden" name="batchToken" value="{{batchToken}}">
  {{> admin/calendar/room-select}}
  <div class="row g-3">
    <div class="mb-3 col-md-3">
      <label for="batch-start-time">開始時間（台北）</label>
      <input type="time" class="form-control" id="batch-start-time" name="startTime" value="{{values.startTime}}" step="60" required>
    </div>
    <div class="mb-3 col-md-3">
      <label for="batch-end-time">結束時間（台北）</label>
      <input type="time" class="form-control" id="batch-end-time" name="endTime" value="{{values.endTime}}" step="60" required>
    </div>
    <div class="mb-3 col-md-6">
      <label for="batch-teacher">授課老師</label>
      <select class="form-control" id="batch-teacher" name="teacherId" required>
        <option value="">請選擇授課老師</option>
        {{#each teachers}}
        <option value="{{this.id}}"{{#if this.isSelected}} selected{{/if}}>{{referenceLabel this.User.userNo this.name}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  <div class="mb-3">
    <label for="batch-content">課堂內容（選填）</label>
    <textarea class="form-control" id="batch-content" name="content" rows="2" maxlength="40">{{values.content}}</textarea>
  </div>

  {{> admin/calendar/batch-date-picker}}

  <button type="submit" id="batch-submit" class="btn btn-primary" disabled>建立所選日期的課堂</button>
  <a href="/admin/courses/{{course.id}}/calendar" class="btn btn-secondary">返回課堂列表</a>
</form>
<noscript>
  <p class="mt-3">多選月曆需要 JavaScript。你仍可以<a href="/admin/courses/{{course.id}}/sessions/create">新增單堂課</a>。</p>
</noscript>
</div>
