{{> workspace/page-heading}}

<div class="ws-content">
<p class="ws-context">{{referenceLabel course.courseNo course.name}}</p>
<form class="ws-form" action="/cramschool/courses/{{course.id}}/diaries" method="POST">
      <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
  <div class="mb-3">
    <label for="date" class="form-label">日期:</label>
    <input type="date" class="form-control" id="date" name="date" required>
  </div>

  <div class="mb-3">
    <label for="subject" class="form-label">主題: </label>
    <input type="text" class="form-control" id="subject" name="subject" placeholder="...輸入日誌主題" maxlength="40"
        required>
  </div>

  <div class="mb-3">
    <label for="content" class="form-label">內容: </label>
    <textarea class="form-control" id="content" rows="3" name="content" placeholder="...輸入內容" required></textarea>
  </div>

  <button type="submit" class="btn btn-primary">送出</button>
</form>
<a href="/cramschool/courses/{{course.id}}/diaries">返回列表</a>
</div>
