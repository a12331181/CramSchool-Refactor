<h1 class="mt-3">學生月費合併預覽</h1>

<form method="GET" action="{{previewUrl}}" class="mb-3">
  <label for="billing-month">計費月份</label>
  <input id="billing-month" type="month" name="billingMonth" value="{{billingMonth}}" required>
  <button type="submit" class="btn btn-sm btn-primary">查看試算</button>
</form>

{{#if activeBill}}
<section class="my-3" aria-labelledby="saved-month-bill-heading">
  <h2 id="saved-month-bill-heading" class="h5">本月帳單</h2>
  <p>{{activeBill.studentNameSnapshot}}｜{{activeBill.statusText}}｜帳單金額 NT$ {{activeBill.totalAmount}}</p>
  <a href="{{activeBill.detailUrl}}" class="btn btn-sm btn-outline-primary">查看帳單 #{{activeBill.id}}</a>
</section>
{{/if}}

{{#if voidedBills.length}}
<details class="my-3">
  <summary class="font-weight-bold">本月作廢與捨棄紀錄（{{voidedBills.length}}）</summary>
  <ul class="mt-2">
    {{#each voidedBills}}
    <li>
      <a href="{{detailUrl}}">帳單 #{{id}}</a>｜{{studentNameSnapshot}}｜{{statusText}}｜原金額 NT$ {{totalAmount}}
    </li>
    {{/each}}
  </ul>
</details>
{{/if}}

  {{#with leaveReviewPanel}}
  <section class="my-4" aria-labelledby="leave-review-title">
    <h2 id="leave-review-title" class="h5">{{reviewMonth}} 請假審核</h2>
    <p class="text-muted">這裡審核請假原因，折抵金額會另行核對。</p>
  
    {{#if timezoneError}}
    <p class="alert alert-warning">系統時間設定異常，暫時無法讀取請假。</p>
    {{else}}
    <div class="table-responsive">
      <table class="table table-bordered">
        <thead>
          <tr>
            <th scope="col">上課時間（台北）</th>
            <th scope="col">課程</th>
            <th scope="col">請假原因</th>
            <th scope="col">審核結果</th>
            <th scope="col">操作</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <td>{{classAtText}}</td>
            <td>{{courseName}}</td>
            <td>{{#if leaveReason}}{{leaveReason}}{{else}}未填寫{{/if}}</td>
            <td>
              {{decisionText}}
              {{#if reviewReason}}
              <div class="small text-muted">{{reviewReason}}</div>
              {{/if}}
            </td>
            <td>
              {{#if canReview}}
              <details>
                <summary>審核請假原因</summary>
                <form method="POST" action="{{../actionBase}}/{{attendId}}" class="mt-2">
                  <input type="hidden" name="tuitionFormToken" value="{{../formToken}}">
                  <input type="hidden" name="billingMonth" value="{{../billingMonth}}">
                  <input type="hidden" name="attendVersion" value="{{attendVersion}}">
                  <input type="hidden" name="reviewId" value="{{reviewId}}">
  
                  <label for="leave-decision-{{attendId}}">審核結果</label>
                  <select id="leave-decision-{{attendId}}" name="decision" class="form-control mb-2" required>
                    <option value="" selected disabled>請選擇</option>
                    <option value="approved">核准原因</option>
                    <option value="rejected">駁回</option>
                  </select>
  
                  <label for="leave-note-{{attendId}}">審核備註</label>
                  <input id="leave-note-{{attendId}}" name="reviewReason" type="text" class="form-control mb-2"
                    value="{{reviewReason}}" maxlength="255" required>
  
                  <button type="submit" class="btn btn-sm btn-primary">儲存審核</button>
                </form>
              </details>
              {{else}}
              <span class="text-muted">請先核對點名資料</span>
              {{/if}}
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5">上月沒有符合條件的請假紀錄。</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}
  </section>
  {{/with}}

{{#if errorMessage}}
<p class="alert alert-warning">{{errorMessage}}</p>
{{/if}}

{{#if preview}}
<h2 class="h5">{{preview.student.name}}｜{{preview.billingMonth}}</h2>
<p class="text-muted">依現行課程價格試算。小計只包含已試算的基本學費。</p>

{{#if reviewRows.length}}
<div class="alert alert-warning">
  <h3 class="h6">待核對項目</h3>
  <ul class="mb-0">
    {{#each reviewRows}}
    <li>
      {{this.label}}：{{this.message}}
      {{#if this.count}}（{{this.count}} 筆）{{/if}}
      {{#if this.enrollmentId}}（選課 #{{this.enrollmentId}}）{{/if}}
      {{#if this.calendarId}}（課堂 #{{this.calendarId}}）{{/if}}
    </li>
    {{/each}}
  </ul>
</div>
{{/if}}

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">課程</th>
      <th scope="col">計費方式</th>
      <th scope="col">適用堂數</th>
      <th scope="col">基本學費</th>
      <th scope="col">明細</th>
    </tr>
  </thead>
  <tbody>
    {{#each courseRows}}
    <tr>
      <th scope="row">{{this.course.name}}</th>
      <td>{{this.course.type}}</td>
      <td>{{this.billableCount}}</td>
      <td>{{this.quantity}} × NT$ {{this.unitPrice}} ＝ NT$ {{this.baseAmount}}</td>
      <td><a href="{{this.detailUrl}}">單課預覽</a></td>
    </tr>
    {{else}}
    <tr>
      <td colspan="5">目前沒有可顯示試算的課程。</td>
    </tr>
    {{/each}}
  </tbody>
</table>

{{#if hasSubtotal}}
<p><strong>已試算課程小計：NT$ {{preview.baseSubtotal}}</strong></p>
{{else}}
<p>目前還無法計算小計，請先核對上方資料。</p>
{{/if}}
{{#if draftFormToken}}
<form method="POST" action="{{draftAction}}" class="mb-3">
  <input type="hidden" name="billingMonth" value="{{preview.billingMonth}}">
  <input type="hidden" name="tuitionFormToken" value="{{draftFormToken}}">
  <button type="submit" class="btn btn-primary">儲存草稿</button>
</form>
{{/if}}
{{/if}}

<a href="/cramschool/payment">回到繳費紀錄</a>