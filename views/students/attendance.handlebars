{{> workspace/page-heading}}

<div class="ws-content">
<p class="ws-context">{{referenceLabel course.courseNo course.name}} · {{referenceLabel student.studentNo student.name}}</p>
<div class="table-responsive">
<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">課堂編號</th>
      <th scope="col">上課時間（台北）</th>
      <th scope="col">上課內容</th>
      <th scope="col">出席狀況</th>
      <th scope="col">原因／備註</th>
    </tr>
  </thead>
  <tbody>
    {{#each attends}}
    <tr>
      <th scope="row">{{this.calendarId}}</th>
      <td>{{this.startAtText}}</td>
      <td>{{this.content}}</td>
      <td>
        {{this.statusText}}
        {{#if this.isCancelled}}<small class="d-block text-muted">課堂已取消</small>{{/if}}
      </td>
      <td>{{#if this.reason}}{{this.reason}}{{else}}—{{/if}}</td>
    </tr>
    {{else}}
    <tr>
      <td colspan="5" class="text-center text-muted">目前沒有出缺席紀錄。</td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
{{#if attends.length}}
<p class="text-muted">共 {{attends.length}} 筆出缺席紀錄。</p>
{{/if}}

<a href="/cramschool/students/{{student.id}}">回學生資料</a>
<span aria-hidden="true">｜</span>
<a href="/cramschool/courses/{{course.id}}/enrolledstudents">回課程學生名單</a>
</div>
