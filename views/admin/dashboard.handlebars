<div class="ws-heading"><h1>後台總覽</h1><a class="ws-btn ws-primary" href="/admin/students/create">{{> workspace/icon name="plus"}}新增學生</a></div>
{{#*inline "admin-entry"}}
<a class="ws-shortcut" href="{{url}}"><span class="ws-tile-icon {{tint}}">{{> workspace/icon name=symbol}}</span><div><h2>{{label}}</h2><p>{{description}}</p></div>{{> workspace/icon name="chevron"}}</a>
{{/inline}}
<div class="ws-shortcuts ws-admin-cards">
  {{> admin-entry url="/admin/students" symbol="users" tint="ws-mint" label="學生管理" description="學生資料、學籍與選課"}}
  {{> admin-entry url="/admin/courses" symbol="book" label="課程管理" description="課程設定、排課與結課"}}
  {{> admin-entry url="/admin/teachers" symbol="teacher" tint="ws-blue" label="教師管理" description="教師資料與在職狀態"}}
  {{> admin-entry url="/admin/users" symbol="key" tint="ws-blue" label="帳號管理" description="邀請新老師或調整權限"}}
  {{> admin-entry url="/admin/extrafees" symbol="receipt" label="額外費用" description="費用項目與收費金額"}}
</div>
