{{> workspace/page-heading}}

<div class="ws-content">
{{#if course}}
<form class="ws-form" action="/admin/courses/{{course.id}}?_method=PUT" method="POST">
{{else}}
<form class="ws-form" action="/admin/courses" method="POST">
{{/if}}
  {{#if course}}
  <p>課程編號：<strong>{{#if course.courseNo}}{{course.courseNo}}{{else}}—{{/if}}</strong></p>
  {{else}}
  <fieldset class="mb-3">
    <legend class="h6">課程編號開頭</legend>
    <div class="form-row">
      <div class="col">
        <label for="course-prefix-first">第一個英文字母</label>
        <select class="form-control" name="coursePrefixFirst" id="course-prefix-first" required>
          <option value="">請選擇</option>
          {{#each prefixLetters}}<option value="{{this}}">{{this}}</option>{{/each}}
        </select>
      </div>
      <div class="col">
        <label for="course-prefix-second">第二個英文字母</label>
        <select class="form-control" name="coursePrefixSecond" id="course-prefix-second" required>
          <option value="">請選擇</option>
          {{#each prefixLetters}}<option value="{{this}}">{{this}}</option>{{/each}}
        </select>
      </div>
    </div>
    <small class="form-text text-muted">系統會接上補習班代碼與流水號，例如 MA0010001。</small>
  </fieldset>
  {{/if}}
  <div class="mb-3">
    <label for="name">課程名稱</label>
    <input type="text" class="form-control" name="name" id="name" placeholder="輸入課程名稱" value="{{course.name}}" required {{#if course}} readonly {{/if}}>
  </div>

  <div class="mb-3">
    <label for="time">上課時長</label>
    <select class="form-control" name="time" id="time">
      {{#each timeList}}
      <option value="{{this.time}}" 
        {{#ifCond ../course.time this.time}} 
          selected 
        {{/ifCond}}>{{this.time}}分鐘
      </option>
      {{/each}}
    </select>
  </div>

  <div class="mb-3">
    <label for="type">計費方式</label>
    <select class="form-control" name="type" id="type">
      {{#each typeList}}
      <option value="{{this.type}}" 
        {{#ifCond ../course.type this.type}} 
          selected 
        {{/ifCond}}>{{this.type}}
      </option>
      {{/each}}
    </select>
  </div>

  <div class="mb-3">
    <label for="price">價格（NT$）</label>
    <input type="number" class="form-control" name="price" id="price" min="0" max="{{maxPrice}}" step="1" value="{{course.price}}" placeholder="輸入價格" required>
    <small class="form-text text-muted">月費制填整月金額；堂數制填每堂單價，堂數依該月的正式排課計算。</small>
  </div>

  <div class="mb-3">
    <label for="teacherId">授課老師</label>
    <select class="form-control" id="teacherId" name="teacherId">
      {{#each teachers}}
      <option value="{{this.id}}" 
        {{#ifCond this.id ../course.TeacherId}} 
          selected
        {{/ifCond}}>{{referenceLabel this.User.userNo this.name}}{{#unless this.isActiveTeacher}}（原任教師，目前非在職）{{/unless}}
      </option>
      {{/each}}
    </select>
  </div>

  <button type="submit" class="btn btn-primary">送出資料</button>
</form>
<a href="/admin/courses">返回列表</a>
</div>
