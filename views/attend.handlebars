{{#if isFormalCalendar}}
<br>
<h1>{{course.name}}</h1>
<h5>本堂學生名單</h5>
<p>台北時間：{{startAtText}} ～ {{endAtText}}</p>
<p>課堂內容：{{calendar.content}}</p>
<p class="text-muted">名單以 {{calendarDate}} 的選課期間判定。</p>

{{#if pendingCount}}
<p class="alert alert-info">
  另有 {{pendingCount}} 位學生的選課日期待核對。
</p>
{{/if}}

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">學生編號</th>
      <th scope="col">姓名</th>
      <th scope="col">點名結果</th>
      <th scope="col">原因／備註</th>
      <th scope="col">操作</th>
    </tr>
  </thead>
  <tbody>
    {{#each students}}
    <tr>
      <td>{{this.id}}</td>
      <td>{{this.name}}</td>
      <td>{{this.attendText}}</td>
      <td>
        {{#if this.attendReason}}
        {{this.attendReason}}
        {{else}}
        —
        {{/if}}
      </td>
      <td>
        {{#if this.canCreateAttend}}
        <form method="POST"
          action="/cramschool/attend/courses/{{../course.id}}/calendar/{{../calendar.id}}/students/{{this.id}}">
          <input type="hidden" name="calendarStartAt" value="{{../calendarStartAt}}">
          <input type="hidden" name="calendarEndAt" value="{{../calendarEndAt}}">
        
          <label for="attend-status-{{this.id}}">狀態</label>
          <select id="attend-status-{{this.id}}" name="status" class="form-select form-select-sm" required>
            <option value="" selected disabled>請選擇</option>
            <option value="present">出席</option>
            <option value="absent">缺席</option>
            <option value="excused">請假</option>
          </select>
        
          <label for="attend-reason-{{this.id}}" class="mt-2">原因／備註</label>
          <input id="attend-reason-{{this.id}}" name="reason" type="text" class="form-control form-control-sm" maxlength="255"
            placeholder="請假時必填">
        
          <button type="submit" class="btn btn-sm btn-primary mt-2">送出點名</button>
        </form>
        {{else}}
        —
        {{/if}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="5">目前沒有日期已確認的學生。</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<a href="/cramschool/attend">回到點名首頁</a>
{{else}}

<br>

<h1><strong>上課日期: </strong>{{calendar.date}}</h1>

<h5 class="ml-2" style="color: rgb(126, 120, 113);"><strong>課程內容: </strong>{{calendar.content}}</h5>

<table class="table table-bordered">
  <thead>
    <tr class="table-primary">
      <th scope="col">#</th>
      <th scope="col">學生姓名</th>
      <th scope="col">性別</th>
      <th scope="col">年級</th>
      <th scope="col">表單</th>
    </tr>
  </thead>
  <tbody>
    {{#each students}}
    <tr class="table-light">
      <th scope="row">{{this.id}}</th>
      <td>{{this.name}}</td>
      <td>{{this.sex}}</td>
      <td>{{this.grade}}</td>
      <th scope="col">
        {{#if this.isChecked }}
        <div class="container">
          <div class="row">
            <p class="mr-3 my-1" style="color: rgb(95, 209, 80);">√已提交</p>
            <form action="/cramschool/attend/calendar/{{../calendar.id}}/students/{{this.id}}?_method=DELETE" method="POST"
            style="display: inline;">
              <button type="submit" class="btn btn-danger btn-sm">刪除紀錄</button>
            </form>
          </div>
        </div>
        {{else}}
        <form action="/cramschool/attend/calendar/{{../calendar.id}}/students/{{this.id}}" method="POST" style="display: inline;">
          <div class="form-group mb-3">
            <label for="status"></label>
            <select class="form-select" id="status" name="status">
              <option value="出席">出席</option>
              <option value="缺席/事假">事假</option>
              <option value="缺席/病假">病假</option>
              <option value="缺席/喪假">喪假</option>
              <option value="缺席/無故缺席">無故缺席</option>
            </select>
            <button class="btn-sm btn-secondary" type="submit">送出</button>
          </div>
        </form>
        {{/if}}
      </th>
    </tr>
    {{/each}}
  </tbody>
</table>

<br />
<br />
<a href="/cramschool/attend/courses/{{course.id}}">回到上一頁</a>

{{/if}}