<h1 class="h4">課程收費列表</h1>

<table class="table table-bordered">
  <thead>
    <tr class="table-primary">
      <th scope="col">#</th>
      <th scope="col">課程名稱</th>
      <th scope="col">#</th>
    </tr>
  </thead>
  <tbody>
    {{#each courses}}
    <tr class="table-light">
      <th scope="row">{{this.dataValues.id}}</th>
      <td>{{this.dataValues.name}}</td>
      <td>
        <a href="/cramschool/tuition/courses/{{this.dataValues.id}}/monthly" class="btn btn-sm btn-primary">
          每月學費明細
        </a>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>