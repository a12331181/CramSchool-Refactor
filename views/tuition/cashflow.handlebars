<br>

{{> staff-nav activeTab="cashflow" showBilling=user.isAdmin}}

<br>

<h1 class="h4">收退費對帳</h1>
<p class="text-muted">依實際收款日與退費日對帳。明細另列帳單的計費月份。</p>

<form method="GET" action="{{formAction}}" class="mb-3">
  <label for="cashflow-month">收退費月份：</label>
  <input id="cashflow-month" type="month" name="cashMonth" value="{{cashMonth}}" required>
  <button type="submit" class="btn btn-sm btn-primary">查看</button>
</form>

{{#if error}}
<p class="alert alert-warning" role="alert">{{error}}</p>
{{else}}
<dl class="row mb-3">
  <div class="col-sm-4"><dt>實際收款</dt><dd>{{receivedText}}</dd></div>
  <div class="col-sm-4"><dt>實際退費</dt><dd>{{refundedText}}</dd></div>
  <div class="col-sm-4"><dt>淨流入</dt><dd>{{netText}}</dd></div>
</dl>

{{#if reviewCount}}
<p class="alert alert-warning">有 {{reviewCount}} 筆紀錄待核對，未計入合計；包含無法判定月份的舊收款。</p>
{{/if}}

<nav class="mb-3" aria-label="對帳清單">
  <a class="btn btn-sm {{#unless showReview}}btn-primary{{else}}btn-outline-primary{{/unless}}"
    href="{{verifiedUrl}}"{{#unless showReview}} aria-current="page"{{/unless}}>可核對 {{totalCount}} 筆</a>
  <a class="btn btn-sm {{#if showReview}}btn-primary{{else}}btn-outline-primary{{/if}}"
    href="{{reviewUrl}}"{{#if showReview}} aria-current="page"{{/if}}>待核對 {{reviewCount}} 筆</a>
  <a class="btn btn-sm btn-outline-secondary" href="{{exportUrl}}">下載已核對的 CSV</a>
</nav>

<div class="table-responsive">
  <table class="table table-sm table-bordered">
    <thead class="table-secondary">
      <tr>
        <th scope="col">實際日期</th>
        <th scope="col">紀錄</th>
        <th scope="col">學生</th>
        <th scope="col">帳單月份</th>
        <th scope="col">金額</th>
        <th scope="col">來源帳單</th>
        {{#if showReview}}<th scope="col">待核對原因</th>{{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>{{date}}</td>
        <td>{{kindText}} #{{id}}</td>
        <td>{{studentName}}</td>
        <td>{{billingMonth}}</td>
        <td>{{amountText}}</td>
        <td>
          {{#if billUrl}}<a href="{{billUrl}}">帳單 #{{billId}}</a>
          {{else}}{{#if billId}}帳單 #{{billId}}{{else}}—{{/if}}{{/if}}
        </td>
        {{#if ../showReview}}<td>{{reviewText}}</td>{{/if}}
      </tr>
      {{else}}
      {{#if showReview}}
      <tr><td colspan="7">沒有待核對的紀錄。</td></tr>
      {{else}}
      <tr><td colspan="6">本月沒有可核對的收退費。</td></tr>
      {{/if}}
      {{/each}}
    </tbody>
  </table>
</div>

{{> pagination ariaLabel="收退費對帳分頁"}}
{{/if}}
