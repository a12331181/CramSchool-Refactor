{{> workspace/page-heading}}

<div class="ws-content">
{{#if totalCount}}<p class="text-muted">共 {{totalCount}} 位老師</p>{{/if}}
<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <th scope="col">老師編號</th>
        <th scope="col">老師姓名</th>
        <th scope="col">聯絡電話</th>
        <th scope="col">信箱</th>
        <th scope="col">操作</th>
      </tr>
    </thead>
    <tbody>
      {{#each teachers}}
      <tr>
        <td>{{#if User.userNo}}{{User.userNo}}{{else}}—{{/if}}</td>
        <th scope="row">{{name}}</th>
        <td>{{#if phone}}{{phone}}{{else}}—{{/if}}</td>
        <td>{{#if User.email}}{{User.email}}{{else}}—{{/if}}</td>
        <td>{{#if UserId}}<a href="/users/{{UserId}}" class="btn btn-sm btn-outline-dark">基本資料</a>{{else}}—{{/if}}</td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="text-center text-muted">目前沒有可顯示的老師。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{#if totalCount}}{{> pagination ariaLabel="老師列表分頁"}}{{/if}}
</div>
