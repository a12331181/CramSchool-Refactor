{{> workspace/page-heading}}

<div class="ws-content">
{{#if extrafee}}
<form class="ws-form" action="/admin/extrafees/{{extrafee.id}}?_method=PUT" method="POST">
{{else}}
<form class="ws-form" action="/admin/extrafees" method="POST">
{{/if}}
  <div class="mb-3">
    <label for="name">名稱</label>
    <input type="text" class="form-control" name="name" id="name" value="{{extrafee.name}}" required >
  </div>

  <div class="mb-3">
    <label for="price">價錢</label>
    <input type="number" class="form-control" name="price" id="price" value="{{extrafee.price}}" min="1" max="{{maxPrice}}" step="1" required>
  </div>

  <button type="submit" class="btn btn-primary">送出資料</button>
</form>
<a href="/admin/extrafees">返回列表</a>
</div>
