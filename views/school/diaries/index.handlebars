<br>

<h3 class="ml-2" style="color: rgb(75, 66, 57);">教師日誌列表</h3>

<table class="table table-bordered">
  <thead>
    <tr class="table-primary">
      <th scope="col">#</th>
      <th scope="col">日期</th>
      <th scope="col">主題</th>
      <th scope="col">課程</th>
      <th scope="col">教師</th>
      {{#if showDeleteColumn}}
      <th scope="col">#</th>
      {{/if}}
    </tr>
  </thead>
  <tbody>
    {{#each diaries}}
    <tr class="table-light">
      <th scope="row">{{this.id}}</th>
      <td>{{this.date}}</td>
      <td><a href="/cramschool/courses/{{this.Course.id}}/diaries/{{this.id}}">{{this.subject}}</a></td>
      <td style="color: rgb(211, 146, 60);">{{referenceLabel this.Course.courseNo this.Course.name}}</td>
      <td style="color: rgb(124, 150, 199);">{{referenceLabel this.Teacher.User.userNo this.Teacher.name}}</td>
      {{#if ../showDeleteColumn}}
      <td>
        {{#if canDelete}}
        <form action="/cramschool/diaries/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-sm btn-danger">刪除</button>
        </form>
        {{/if}}
      </td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>

{{> pagination ariaLabel="全校教師日誌分頁"}}

<br />
