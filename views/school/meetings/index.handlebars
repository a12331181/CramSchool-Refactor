{{#> workspace/page-heading}}
  <a class="ws-btn ws-primary" href="/cramschool/meetings/create">{{> workspace/icon name="plus"}}建立會議紀錄</a>
{{/workspace/page-heading}}

<div class="ws-content">
<div class="table-responsive">
<table class="ws-mobile-cards table table-bordered">
  <thead>
    <tr>
      <th scope="col">編號</th>
      <th scope="col">開會日期</th>
      <th scope="col">主題</th>
      <th scope="col">操作</th>
    </tr>
  </thead>
  <tbody>
    {{#each meetings}}
    <tr>
      <th scope="row" data-label="編號">{{this.id}}</th>
      <td data-label="開會日期">{{this.date}}</td>
      <td class="ws-cell-title" data-label="主題">{{this.subject}}</td>
      <td class="ws-cell-actions" data-label="操作">
        <a href="/cramschool/meetings/{{this.id}}" class="btn btn-dark btn-sm my-1">
          會議內容
        </a>
        {{#if ../isAdmin}}
        <form action="/cramschool/meetings/{{this.id}}?_method=DELETE" method="POST"
          class="ws-inline">
          <button type="submit" class="btn btn-danger btn-sm ml-1 my-1">刪除</button>
        </form>
        {{/if}}
      </td>
    </tr>
    {{else}}
    <tr><td colspan="4">目前沒有會議紀錄。</td></tr>
    {{/each}}
  </tbody>
</table>
</div>
{{> pagination ariaLabel="會議紀錄分頁"}}
<a href="/cramschool">回到主頁面</a>
</div>
