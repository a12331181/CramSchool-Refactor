<section class="ws-sheet ws-profile" aria-labelledby="profile-name">
  {{#if student.image}}
  <img src="{{student.image}}" alt="{{student.name}}的照片">
  {{else}}
  <span class="ws-monogram" aria-hidden="true">{{initial student.name}}</span>
  {{/if}}
  <div><h2 id="profile-name">{{referenceLabel student.studentNo student.name}}</h2>
    <table class="table ws-facts-table" aria-label="基本資料"><tbody>
      <tr><th scope="row">性別</th><td>{{#if student.sex}}{{student.sex}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">生日</th><td>{{#if student.birth}}{{student.birth}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">學校</th><td>{{#if student.school}}{{student.school}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">年級</th><td>{{#if student.grade}}{{student.grade}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">聯絡電話</th><td>{{#if student.tel}}{{student.tel}}{{else}}—{{/if}}</td></tr>
      <tr><th scope="row">地址</th><td>{{#if student.address}}{{student.address}}{{else}}—{{/if}}</td></tr>
    </tbody></table>
  </div>
</section>
