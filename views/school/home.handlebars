<div class="ws-heading">
  <div><h1>校務總覽</h1><p class="ws-date">{{today}}</p></div>
  <a class="ws-btn ws-primary" href="/cramschool/attend">{{> workspace/icon name="checklist"}}開啟點名</a>
</div>

<div class="ws-shortcuts">
  <a class="ws-shortcut" href="/cramschool/courses"><span class="ws-tile-icon">{{> workspace/icon name="book"}}</span><div><h2>課程列表</h2><p>查看課程與行事曆</p></div>{{> workspace/icon name="chevron"}}</a>
  <a class="ws-shortcut" href="/cramschool/students"><span class="ws-tile-icon ws-mint">{{> workspace/icon name="users"}}</span><div><h2>學生名單</h2><p>依課程查找學生</p></div>{{> workspace/icon name="chevron"}}</a>
  {{#if isAdmin}}
  <a class="ws-shortcut" href="/cramschool/tuition/cashflow"><span class="ws-tile-icon ws-blue">{{> workspace/icon name="flow"}}</span><div><h2>收退費對帳</h2><p>查看每月收款與退款</p></div>{{> workspace/icon name="chevron"}}</a>
  {{else}}
  <a class="ws-shortcut" href="/cramschool/teachers"><span class="ws-tile-icon ws-blue">{{> workspace/icon name="teacher"}}</span><div><h2>教師名單</h2><p>查看在職教師資料</p></div>{{> workspace/icon name="chevron"}}</a>
  {{/if}}
</div>

<div class="ws-records">
  <section class="ws-panel" aria-labelledby="journal-title">
    <header class="ws-panel-head"><h2 id="journal-title">{{> workspace/icon name="journal"}}近期教師日誌</h2><a class="ws-link" href="/cramschool/diaries">全部日誌{{> workspace/icon name="arrow"}}</a></header>
    {{#if diaries}}
    <div class="ws-scroll"><table class="ws-table">
      <thead><tr><th scope="col">日期</th><th scope="col">日誌主題</th><th scope="col">課程</th></tr></thead>
      <tbody>{{#each diaries}}<tr><td class="ws-num">{{date}}</td><td><a class="ws-record-link" href="/cramschool/courses/{{Course.id}}/diaries/{{id}}">{{subject}}</a></td><td class="ws-muted">{{referenceLabel Course.courseNo Course.name}}</td></tr>{{/each}}</tbody>
    </table></div>
    {{else}}<p class="ws-empty">目前沒有教師日誌。</p>{{/if}}
  </section>
  <section class="ws-panel" aria-labelledby="meeting-title">
    <header class="ws-panel-head"><h2 id="meeting-title">{{> workspace/icon name="meeting"}}近期會議</h2><a class="ws-link" href="/cramschool/meetings">全部會議{{> workspace/icon name="arrow"}}</a></header>
    <ul class="ws-meetings">
      {{#each meetings}}<li><a href="/cramschool/meetings/{{id}}"><span class="ws-meet-icon">{{> workspace/icon name="calendar"}}</span><span><strong>{{subject}}</strong><small>{{date}}</small></span></a></li>
      {{else}}<li class="ws-empty">目前沒有會議紀錄。</li>{{/each}}
    </ul>
  </section>
</div>
<div class="ws-note">{{> workspace/icon name="id"}}<span>新進教師請先填寫個人資料。</span><a href="/users/{{user.id}}/edit">編輯個人資料{{> workspace/icon name="arrow"}}</a></div>
