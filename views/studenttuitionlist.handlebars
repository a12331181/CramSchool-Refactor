<h1 class="mt-3">學生學費列表</h1>
<p class="text-muted">在學學生的本月帳單與收款狀況。尚未開單時顯示基本學費試算。</p>

<a href="/cramschool/payment" class="btn btn-outline-secondary mb-3">
  改按課程查看
</a>

<form action="{{listUrl}}" method="GET" class="mb-3">
  <label for="billing-month">計費月份</label>
  <input id="billing-month" type="month" name="billingMonth"
    value="{{billingMonth}}" required>
  <button type="submit" class="btn btn-sm btn-primary">查看月學費</button>
</form>

{{#if errorMessage}}
  <p class="alert alert-warning">{{errorMessage}}</p>
{{else}}
  <p>共 {{totalCount}} 位在學學生</p>

  <table class="table table-bordered">
    <thead>
      <tr>
        <th scope="col">學生</th>
        <th scope="col">本月金額</th>
        <th scope="col">帳單／收款狀態</th>
        <th scope="col">未收金額</th>
        <th scope="col">明細</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
        <tr>
          <th scope="row">{{this.student.name}}</th>
          <td>
            {{#if this.hasAmount}}
            NT$ {{this.amount}}
            <small class="d-block text-muted">{{this.amountSourceText}}</small>
            {{else}}—{{/if}}
          </td>
          <td>{{this.statusText}}</td>
          <td>{{#if this.hasRemainingAmount}}NT$ {{this.remainingAmount}}{{else}}—{{/if}}</td>
          <td>
            {{#if this.billUrl}}<a class="mr-2" href="{{this.billUrl}}">查看帳單</a>{{/if}}
            <a href="{{this.previewUrl}}">合併預覽</a>
          </td>
        </tr>
      {{else}}
        <tr><td colspan="5">目前沒有在學學生。</td></tr>
      {{/each}}
    </tbody>
  </table>

  <nav aria-label="學生學費列表分頁">
    {{#if prevUrl}}<a href="{{prevUrl}}">上一頁</a>{{/if}}
    <span class="mx-2">第 {{pagination.page}} / {{pagination.totalPages}} 頁</span>
    {{#if nextUrl}}<a href="{{nextUrl}}">下一頁</a>{{/if}}
  </nav>
{{/if}}