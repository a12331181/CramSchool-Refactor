<br />

<h1>資料管理後台</h1>

{{> admin-nav activeTab="extra-fees"}}

<table class="table table-bordered">
  <thead class="thead-dark">
    <tr>
      <th scope="col">#</th>
      <th scope="col">費用名稱</th>
      <th scope="col">價格</th>
      <th scope="col">#</th>
    </tr>
  </thead>
  <tbody>
    {{#each extrafees}}
    <tr class="table-light">
      <th scope="row">{{this.id}}</th>
      <td>{{this.name}}</td>
      <td>{{this.price}}</td>
      <td>
        <a href="/admin/extrafees/{{this.id}}/edit">修改</a>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<br />
<br />

<a href='/admin/extrafees/create'>
  <button type="button" class="btn btn-primary">建立新的額外費用</button>
</a>