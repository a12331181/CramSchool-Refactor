{{#with (workspacePage @exphbs.view @root) as |page|}}
<header class="ws-heading ws-page-heading">
  <div class="ws-page-title"><span class="ws-tile-icon ws-mint">{{> workspace/icon name=page.icon}}</span><h1>{{page.title}}</h1></div>
  {{#if @partial-block}}<div class="ws-tools">{{> @partial-block @root}}</div>{{/if}}
</header>
{{/with}}
