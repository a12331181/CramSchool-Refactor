{{> workspace/page-heading}}

<div class="ws-content">
<p class="ws-context">{{referenceLabel course.courseNo course.name}}</p>
<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <th scope="col">學生編號</th>
        <th scope="col">姓名</th>
        <th scope="col">就讀學校</th>
        <th scope="col">年級</th>
        <th scope="col">操作</th>
      </tr>
    </thead>
    <tbody>
      {{#each students}}
      <tr>
        <td>{{#if studentNo}}{{studentNo}}{{else}}—{{/if}}</td>
        <th scope="row">{{name}}</th>
        <td>{{#if school}}{{school}}{{else}}—{{/if}}</td>
        <td>{{#if grade}}{{grade}}{{else}}—{{/if}}</td>
        <td>
          <a href="/cramschool/students/{{id}}" class="btn btn-sm btn-outline-dark">詳細資料</a>
          <a href="/cramschool/students/{{id}}/courses/{{../course.id}}/attend" class="btn btn-sm btn-outline-primary">出缺席紀錄</a>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="text-center text-muted">目前沒有在學選課學生。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

<a href="/cramschool/courses">回課程列表</a>
</div>
