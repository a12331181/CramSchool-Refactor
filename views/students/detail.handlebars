{{> workspace/page-heading}}

<div class="ws-content">
{{> workspace/student-profile}}

{{#if enrolledCourses}}
<h2>目前正在進行的課程</h2>
<div class="ws-cards">
  {{#each enrolledCourses}}
  <article class="ws-sheet"><h3>{{referenceLabel courseNo name}}</h3>
    <div class="ws-tools"><a href="/cramschool/courses/{{id}}/calendar">課程行事曆</a><a href="/cramschool/students/{{../student.id}}/courses/{{id}}/attend">出缺席狀況</a></div>
  </article>
  {{/each}}
</div>
{{else}}
<p class="ws-sheet text-muted">目前無進行中的課程</p>
{{/if}}
<a href="/cramschool/students">回學生名單</a>
</div>
