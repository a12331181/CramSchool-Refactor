{{> workspace/page-heading}}

<div class="ws-content">
<p class="ws-context">{{referenceLabel course.courseNo course.name}}</p>
<form action="{{listUrl}}" method="GET" class="ws-filter">
  <label for="attendance-month" class="me-2">月份（台北）</label>
  <input type="month" class="form-control me-3 mb-1" id="attendance-month" name="month" value="{{month}}">

  <label for="attendance-session-status" class="me-2">課堂狀態</label>
  <select class="form-control me-3 mb-1" id="attendance-session-status" name="status">
    <option value="">全部狀態</option>
    {{#each statusOptions}}
    <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
    {{/each}}
  </select>
  <button type="submit" class="btn btn-sm btn-primary me-2 mb-1">篩選</button>
  <a href="{{listUrl}}">清除篩選</a>
</form>

<p class="text-muted">共 {{totalCount}} 堂，按上課開始時間由新到舊排列。</p>
<div class="table-responsive">
  <table class="ws-mobile-cards table table-bordered">
    <thead>
      <tr>
        <th scope="col">開始時間（台北）</th>
        <th scope="col">結束時間（台北）</th>
        <th scope="col">授課老師</th>
        <th scope="col">課堂狀態</th>
        <th scope="col">課堂內容</th>
        <th scope="col">點名</th>
      </tr>
    </thead>
    <tbody>
      {{#each sessions}}
      <tr>
        <th scope="row" class="ws-cell-title text-nowrap" data-label="開始時間（台北）">{{this.startAtText}}</th>
        <td class="text-nowrap" data-label="結束時間（台北）">{{this.endAtText}}</td>
        <td data-label="授課老師">{{this.teacherName}}</td>
        <td data-label="課堂狀態">{{this.statusText}}</td>
        <td data-label="課堂內容">{{this.content}}</td>
        <td class="ws-cell-actions" data-label="點名">
          {{#if this.canViewStudents}}
          <a class="btn btn-sm btn-outline-primary" href="/cramschool/attend/courses/{{../course.id}}/calendar/{{this.id}}/students">查看名單</a>
          {{else}}—{{/if}}
        </td>
      </tr>
      {{else}}
      <tr><td colspan="6" class="text-center text-muted">沒有符合目前篩選的課堂。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{> pagination ariaLabel="課堂點名分頁"}}
<a href="/cramschool/attend">回到點名首頁</a>
</div>
