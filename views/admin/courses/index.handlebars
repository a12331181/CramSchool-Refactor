{{#> workspace/page-heading}}
  <a class="ws-btn ws-primary" href="/admin/courses/create">{{> workspace/icon name="plus"}}建立新課程</a>
{{/workspace/page-heading}}

<div class="ws-content">
<div class="table-responsive">
  <table class="ws-mobile-cards table"><thead><tr>
    <th scope="col">編號</th><th scope="col">課程名稱</th><th scope="col">上課時長</th><th scope="col">計費方式</th>
    <th scope="col">價格</th><th scope="col">教師</th><th scope="col">狀態</th><th scope="col">操作</th>
  </tr></thead>
  <tbody>
    {{#each courses}}
    <tr>
      <td data-label="編號">{{id}}</td><th scope="row" class="ws-cell-title" data-label="課程名稱">{{referenceLabel courseNo name}}</th><td data-label="上課時長">{{time}} 分鐘</td><td data-label="計費方式">{{type}}</td>
      <td data-label="價格">NT$ {{price}}</td><td data-label="教師">{{referenceLabel Teacher.User.userNo Teacher.name}}</td>
      <td data-label="狀態"><span class="ws-status{{#unless isActive}} ws-inactive{{/unless}}">{{#if isActive}}開課中{{else}}已關閉{{/if}}</span></td>
      <td class="ws-cell-actions" data-label="操作"><div class="ws-tools{{#unless isActive}} ws-closed-actions{{/unless}}">
        <a href="/admin/courses/{{id}}/calendar">行事曆</a>
        <a href="/admin/courses/{{id}}/edit">修改</a>
        <form method="POST" action="/admin/courses/{{id}}?_method=DELETE"><button type="submit" class="btn btn-sm btn-outline-danger">刪除</button></form>
        {{#if isActive}}
        <form method="POST" action="/admin/courses/{{id}}/close?_method=PUT"><button type="submit" class="btn btn-sm btn-outline-secondary">關閉課程</button></form>
        {{else}}
        <form method="POST" action="/admin/courses/{{id}}/open?_method=PUT"><button type="submit" class="btn btn-sm btn-outline-primary">開啟課程</button></form>
        {{/if}}
      </div></td>
    </tr>
    {{else}}
    <tr><td colspan="8">目前沒有可顯示的課程。</td></tr>
    {{/each}}
  </tbody></table>
</div>
{{> pagination ariaLabel="後台課程列表分頁"}}
</div>
