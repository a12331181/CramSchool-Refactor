<br>

<div class="container" style="width: 100%">
  <div class="d-flex align-items-center flex-column mt-3">
    <h2 style="color:#3f353a">現有課程列表</h2>
    
    <br>
    <table class="table table-bordered">
      <thead class="thead-dark">
        <tr>
          <th scope="col">#</th>
          <th scope="col">課程名稱</th>
          <th scope="col">#</th>
        </tr>
      </thead>
      <tbody>
        {{#each courses}}
        <tr class="table-light">
          <th scope="row">{{this.id}}</th>
          <td style="color:#3f3937f5;">
            {{this.name}}
            {{#unless this.isActive}}（已關閉）{{/unless}}
          </td>
          <td>
            {{#if this.isEnrolled }}
              <form action="/admin/students/{{../student.id}}/courses/{{this.id}}/enrolls?_method=DELETE" method="POST" style="display: inline;">
                <input type="hidden" name="enrollmentId" value="{{this.enrollmentId}}">
                <button type="submit" class="btn btn-danger btn-sm">取消課程</button>
              </form>
            {{else}}
              <form action="/admin/students/{{../student.id}}/courses/{{this.id}}/enrolls" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-primary btn-sm">加入課程</button>
              </form>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<br />
<br />
<a href="/admin/students">回到後台學生列表</a>