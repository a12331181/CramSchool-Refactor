{{#if course}}<h2 class="h2">{{course.name}} 學生收費清單</h2>{{/if}} 

{{> tuition/billing-month-filter formAction=listUrl monthLabel="計費月份:" submitText="查看該月學費"}}



{{#if errorMessage}}
<p class="alert alert-warning">{{errorMessage}}</p>
{{else}}
<p class="text-muted">
  正式帳單顯示分攤折扣與折抵後的本課金額。草稿顯示本課原價，尚未形成應收。
</p>
<p>共 {{totalCount}} 位學生</p>

<div class="table-responsive">
  <table class="table table-bordered">
    <thead>
      <tr class="table-secondary">
        <th scope="col">學生姓名</th>
        <th scope="col">本課金額</th>
        <th scope="col">本課已收</th>
        <th scope="col">本課未收</th>
        <th scope="col">帳單／收款狀態</th>
        <th scope="col">明細</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <th scope="row">{{studentName}}</th>
        <td>{{amountText}}</td>
        <td>{{receivedText}}</td>
        <td>{{remainingText}}</td>
        <td>{{statusText}}</td>
        <td>
          {{#if billUrl}}<a class="mr-2" href="{{billUrl}}">查看帳單</a>{{/if}}
          {{#if previewUrl}}<a class="mr-2" href="{{previewUrl}}">帳單草稿</a>{{/if}}
          {{#if historyUrl}}<a href="{{historyUrl}}">歷月學費</a>{{/if}}
        </td>
      </tr>
      {{else}}
      <tr><td colspan="6">本月沒有選課或有效帳單紀錄。</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>

{{> pagination ariaLabel="課程月學費分頁"}}

{{/if}}

<a class="mr-2" href="/cramschool/payment">回到課程收費列表</a>
